# ============================================================
# OBJECTIVE 3 (REGULARISED): CROSS-DIMENSIONAL STABILITY (CDS)
# ------------------------------------------------------------
# Uses REGULARISED efficiencies computed from:
#   M_λ = X'X + λ I
#
# What it produces:
#  (1) Mean efficiencies by (k, family) for D/A/G and cube/sphere
#  (2) CDS indices per family (variance, sd, range, end-to-end change)
#  (3) Scaling-law (decay/growth) exponents beta1 from:
#        log(meanEff) = beta0 + beta1 log(k)
#  (4) PhD-friendly plots + CSV tables
#
# Assumption:
#  You already created df_all for the REGULARISED run
#  with columns (at least):
#    k, family,
#    D_eff_cube, A_eff_cube, G_eff_cube,
#    D_eff_sphere, A_eff_sphere, G_eff_sphere
#
# If your columns have suffix "_lam" or "regularised", update eff_cols below.
# ============================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(readr)

dir.create("results_tables2",  showWarnings = FALSE, recursive = TRUE)
dir.create("results_figures2", showWarnings = FALSE, recursive = TRUE)

# ----------------------------
# 0) Safety checks
# ----------------------------
stopifnot(exists("df_all"))
stopifnot(all(c("k","family") %in% names(df_all)))

# --- IMPORTANT: edit here if your columns are named differently ---
eff_cols <- c(
  "Deff_cube","Aeff_cube","Geff_cube",
  "Deff_sphere","Aeff_sphere","Geff_sphere"
)

miss <- setdiff(eff_cols, names(df_all))
if(length(miss) > 0){
  stop("Missing efficiency columns in df_all: ", paste(miss, collapse = ", "),
       "\nFix: either rename columns or update eff_cols in this script.")
}

df_obj3 <- df_all %>%
  mutate(
    k = as.integer(k),
    family = as.factor(family)
  )

# ----------------------------
# 1) Long format: metric + region
# ----------------------------
eff_long <- df_obj3 %>%
  select(k, family, all_of(eff_cols)) %>%
  pivot_longer(
    cols = all_of(eff_cols),
    names_to = "metric_region",
    values_to = "eff"
  ) %>%
  mutate(
    # --- Extract metric correctly from YOUR names ---
    metric = case_when(
      grepl("^Deff_", metric_region) ~ "D",
      grepl("^Aeff_", metric_region) ~ "A",
      grepl("^Geff_", metric_region) ~ "G",
      TRUE ~ NA_character_
    ),

    # --- Extract region correctly ---
    region = case_when(
      grepl("_cube$", metric_region) ~ "cube",
      grepl("_sphere$", metric_region) ~ "sphere",
      TRUE ~ NA_character_
    ),

    metric = factor(metric, levels = c("D","A","G")),
    region = factor(region, levels = c("cube","sphere"))
  ) %>%
  filter(!is.na(metric), !is.na(region))
# ----------------------------
# 2) Mean efficiencies by k/family
# ----------------------------
tab_mean <- eff_long %>%
  group_by(k, family, metric, region) %>%
  summarise(
    meanEff = mean(eff, na.rm = TRUE),
    sdEff = sd(eff, na.rm = TRUE),
    n = sum(!is.na(eff)),
    .groups = "drop"
  )

write_csv(tab_mean,
          "results_tables/objective3_mean_eff_by_k_family.csv")

# ----------------------------
# 3) CDS stability indices
# ----------------------------
cds_summary <- tab_mean %>%
  group_by(family, metric, region) %>%
  summarise(
    CDS_var = var(meanEff, na.rm = TRUE),
    CDS_sd  = sd(meanEff, na.rm = TRUE),
    CDS_range = max(meanEff) - min(meanEff),
    CDS_drop = meanEff[k == max(k)][1] -
               meanEff[k == min(k)][1],
    mean_over_k = mean(meanEff),
    .groups = "drop"
  )

write_csv(cds_summary,
          "results_tables/objective3_CDS_summary.csv")

# ----------------------------
# 4) Scaling exponent (beta1)
# log(meanEff) = beta0 + beta1 log(k)
# ----------------------------
scaling_fits <- tab_mean %>%
  filter(meanEff > 0) %>%
  mutate(
    logMeanEff = log(meanEff),
    logk = log(k)
  ) %>%
  group_by(family, metric, region) %>%
  do({
    fit <- lm(logMeanEff ~ logk, data = .)
    sm <- summary(fit)

    data.frame(
      beta0 = coef(fit)[1],
      beta1 = coef(fit)[2],
      r2 = sm$r.squared,
      adj_r2 = sm$adj.r.squared,
      p_beta1 = sm$coefficients["logk","Pr(>|t|)"]
    )
  }) %>%
  ungroup()

write_csv(scaling_fits,
          "results_tables/objective3_scaling_exponents.csv")

# ----------------------------
# 5A) Mean efficiency curves
# ----------------------------
p_mean_curves <- ggplot(tab_mean,
