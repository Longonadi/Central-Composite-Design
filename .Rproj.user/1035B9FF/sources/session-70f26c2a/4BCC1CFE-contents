## Construct and evaluate CCDs (FCCD, RCCD, SCCD, and OCCD) over various dimensions, i.e., from k=3 to k=10, and calculate the D-, A-, and G-optimality criteria for the cube and spherical region designs.

## step 1 for k=3,...10 at fixed k=32 for k>5

```{r}
# ============================================================
# REGULARISED SCRIPT (AUTO-SELECT BEST LAMBDA)
#   - Regularised D-, A-, G-criteria via M_lambda = X'X + lambda I
#   - Choose lambda from a grid using mean G-efficiency (tie-break D, A)
#   - Then save results for best lambda
# ============================================================

library(dplyr)
library(ggplot2)
library(readr)
library(tibble)
library(purrr)
library(stringr)
library(FrF2)

dir.create("data_generated",  showWarnings = FALSE, recursive = TRUE)
dir.create("results_tables",  showWarnings = FALSE, recursive = TRUE)
dir.create("results_figures", showWarnings = FALSE, recursive = TRUE)

set.seed(6)

# ----------------------------
# CCD generator (your original)
# ----------------------------
make_ccd <- function(k, family, nc, rf, ra, core = c("full","frac")){
  core <- match.arg(core)

  alpha <- switch(family,
    "FCCD" = 1,
    "RCCD" = (2^k)^(1/4),
    "SCCD" = sqrt(k),
    stop("Unknown family")
  )

 if(core == "full" && k <= 5){
  fac <- as.data.frame(FrF2::FrF2(nruns = 2^k, nfactors = k))
} else {
  fac <- as.data.frame(FrF2::FrF2(nruns = 2^5, nfactors = k))  # fixed 32
}
  fac <- fac[, 1:k, drop = FALSE]
  colnames(fac) <- paste0("x", 1:k)

  fac <- dplyr::mutate_all(fac, ~ifelse(. == 1, 1, -1))
  fac_rep <- fac[rep(seq_len(nrow(fac)), times = rf), , drop = FALSE]

  ax <- matrix(0, nrow = 2*k, ncol = k)
  for(j in 1:k){
    ax[2*j - 1, j] <-  alpha
    ax[2*j,     j] <- -alpha
  }
  ax <- as.data.frame(ax)
  colnames(ax) <- paste0("x", 1:k)
  ax_rep <- ax[rep(seq_len(nrow(ax)), times = ra), , drop = FALSE]

  cen <- as.data.frame(matrix(0, nrow = nc, ncol = k))
  colnames(cen) <- paste0("x", 1:k)

  design_points <- dplyr::bind_rows(fac_rep, ax_rep, cen)

  DesignID <- paste0(family, "_k", k, "_nc", nc, "_rf", rf, "_ra", ra, "_", core)

  meta <- tibble::tibble(
    DesignID = DesignID,
    k = k, family = family, nc = nc, rf = rf, ra = ra, core = core,
    alpha = alpha,
    N  = nrow(design_points),
    Nf = nrow(fac_rep),
    Na = nrow(ax_rep),
    Nc = nrow(cen)
  )

  list(points = design_points, meta = meta)
}

# ----------------------------
# Quadratic model matrix X
# ----------------------------
build_X_quadratic <- function(df){
  vars <- names(df)
  form <- as.formula(paste0(
    "~ ", paste(vars, collapse = " + "),
    " + ", paste0("I(", vars, "^2)", collapse = " + "),
    " + (", paste(vars, collapse = " + "), ")^2"
  ))
  model.matrix(form, data = df)
}

logdet_pd <- function(Mpd){
  R <- chol(Mpd)
  2 * sum(log(diag(R)))
}

# ----------------------------
# Regularised ADG
# ----------------------------
compute_ADG_reg <- function(design_points, region = c("cube","sphere"),
                            g_n = 5000, lambda = 1e-6){
  region <- match.arg(region)

  X <- build_X_quadratic(design_points)
  p <- ncol(X)
  M <- crossprod(X)

  Mlam <- M + diag(lambda, p)

  R <- tryCatch(chol(Mlam), error = function(e) NULL)
  if(is.null(R)) return(NULL)

  Mlam_inv <- chol2inv(R)

  Dcrit <- exp(logdet_pd(Mlam) / p)
  Acrit <- sum(diag(Mlam_inv))

  k <- ncol(design_points)

  if(region == "cube"){
    Z <- matrix(runif(g_n*k, -1, 1), ncol = k)
  } else {
    Z <- matrix(rnorm(g_n*k), ncol = k)
    Z <- Z / sqrt(rowSums(Z^2))
    r <- runif(g_n)^(1/k) * sqrt(k)
    Z <- Z * r
  }

  colnames(Z) <- colnames(design_points)
  Z <- as.data.frame(Z)

  FZ <- build_X_quadratic(Z)
  vx <- rowSums((FZ %*% Mlam_inv) * FZ)
  Gcrit <- max(vx)

  list(Dcrit = Dcrit, Acrit = Acrit, Gcrit = Gcrit)
}

# ============================================================
# PART A: GENERATE DESIGNS + METADATA
# ============================================================
k_grid  <- 3:10
families <- c("FCCD","RCCD","SCCD")
nc_grid <- c(1,3,5,7,10)
rf_grid <- c(1,2,3)
ra_grid <- c(1,2,3)
core_grid <- c("full")

grid <- expand.grid(
  k = k_grid, family = families, nc = nc_grid, rf = rf_grid, ra = ra_grid, core = core_grid,
  stringsAsFactors = FALSE
)

meta_list <- vector("list", nrow(grid))

for(i in seq_len(nrow(grid))){
  row <- grid[i, ]
  out <- make_ccd(row$k, row$family, row$nc, row$rf, row$ra, row$core)
  meta_list[[i]] <- out$meta
  saveRDS(out$points, file.path("data_generated", paste0("design_", out$meta$DesignID, ".rds")))
}

design_metadata <- dplyr::bind_rows(meta_list)
readr::write_csv(design_metadata, "data_generated/design_metadata_reg.csv")

# ============================================================
# PART B: SEARCH OVER LAMBDA GRID
# ============================================================
lambda_grid <- 10^seq(-10, -2, by = 1)   # 1e-10 ... 1e-2
G_N <- 5000

meta <- readr::read_csv("data_generated/design_metadata_reg.csv") %>%
  mutate(DesignID = stringr::str_trim(DesignID))

out_list <- list()
idx <- 1

for(lam in lambda_grid){
  for(i in seq_len(nrow(meta))){
    id <- meta$DesignID[i]
    fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
    if(!file.exists(fpath)) next

    pts <- readRDS(fpath)

    crit_cube <- compute_ADG_reg(pts, "cube",   g_n = G_N, lambda = lam)
    crit_sph  <- compute_ADG_reg(pts, "sphere", g_n = G_N, lambda = lam)
    if(is.null(crit_cube) || is.null(crit_sph)) next

    out_list[[idx]] <- tibble(
      DesignID = id, lambda = lam,
      Dcritical_cube = crit_cube$Dcrit,
      Acritical_cube = crit_cube$Acrit,
      Gcritical_cube = crit_cube$Gcrit,
      Dcritical_sphere = crit_sph$Dcrit,
      Acritical_sphere = crit_sph$Acrit,
      Gcritical_sphere = crit_sph$Gcrit
    )
    idx <- idx + 1
  }
}

mycriteria_raw_by_lambda <- bind_rows(out_list)
write_csv(mycriteria_raw_by_lambda, "data_generated/mycriteria_raw_by_lambda.csv")

# ============================================================
# PART C: EFFICIENCIES WITHIN (lambda, k)
# ============================================================
df_all_lam <- meta %>% inner_join(mycriteria_raw_by_lambda, by = "DesignID")

mycriteria_eff_by_lambda <- df_all_lam %>%
  group_by(lambda, k) %>%
  mutate(
    Deff_cube = Dcritical_cube / max(Dcritical_cube, na.rm=TRUE),
    Aeff_cube = min(Acritical_cube, na.rm=TRUE) / Acritical_cube,
    Geff_cube = min(Gcritical_cube, na.rm=TRUE) / Gcritical_cube,

    Deff_sphere = Dcritical_sphere / max(Dcritical_sphere, na.rm=TRUE),
    Aeff_sphere = min(Acritical_sphere, na.rm=TRUE) / Acritical_sphere,
    Geff_sphere = min(Gcritical_sphere, na.rm=TRUE) / Gcritical_sphere
  ) %>%
  ungroup()

write_csv(mycriteria_eff_by_lambda, "data_generated/mycriteria_eff_by_lambda.csv")

# ============================================================
# PART D: PICK BEST LAMBDA (max mean G overall)
# ============================================================
lambda_summary <- mycriteria_eff_by_lambda %>%
  mutate(
    G_overall = (Geff_cube + Geff_sphere)/2,
    D_overall = (Deff_cube + Deff_sphere)/2,
    A_overall = (Aeff_cube + Aeff_sphere)/2
  ) %>%
  group_by(lambda) %>%
  summarise(
    meanG_overall = mean(G_overall, na.rm=TRUE),
    meanD_overall = mean(D_overall, na.rm=TRUE),
    meanA_overall = mean(A_overall, na.rm=TRUE),
    n = n(),
    .groups = "drop"
  ) %>%
  arrange(desc(meanG_overall), desc(meanD_overall), desc(meanA_overall))

write_csv(lambda_summary, "data_generated/lambda_grid_summary.csv")

best_lambda <- lambda_summary$lambda[1]
writeLines(as.character(best_lambda), "data_generated/best_lambda.txt")
best_lambda

# Save “best lambda” subset
mycriteria_raw_best <- mycriteria_raw_by_lambda %>% filter(lambda == best_lambda)
mycriteria_eff_best <- mycriteria_eff_by_lambda %>% filter(lambda == best_lambda)

write_csv(mycriteria_raw_best, "data_generated/mycriteria_raw_best_lambda.csv")
write_csv(mycriteria_eff_best, "data_generated/mycriteria_eff_best_lambda.csv")

lambda_summary
