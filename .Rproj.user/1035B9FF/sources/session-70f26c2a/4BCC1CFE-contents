# ============================================================
# OBJECTIVE 2 (REGULARISED)
# Spectrum of CCD information matrices
# ============================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(readr)
library(stringr)
library(tibble)

dir.create("results_tables1",  showWarnings = FALSE)
dir.create("results_figures1", showWarnings = FALSE)

lambda <- 1e-2   # best lambda from Objective 1

# ------------------------------------------------------------
# LOAD DATA
# ------------------------------------------------------------

meta <- read_csv("data_generated/design_metadata_reg.csv") %>%
  mutate(DesignID = str_trim(DesignID))

df_all <- read_csv("data_generated/mycriteria_eff_best_lambda.csv") %>%
  mutate(DesignID = str_trim(DesignID))

# ============================================================
# PART 1: SPECTRAL FEATURES
# ============================================================

spec_list <- vector("list", nrow(meta))

for(i in seq_len(nrow(meta))){

  id <- meta$DesignID[i]

  fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
  if(!file.exists(fpath)) next

  pts <- readRDS(fpath)

  X <- build_X_quadratic(pts)
  p <- ncol(X)

  Mlam <- crossprod(X) + lambda * diag(p)

  ev <- sort(eigen(Mlam, symmetric = TRUE, only.values = TRUE)$values)
  ev <- ev[is.finite(ev) & ev > 0]
  if(length(ev) < 5) next

  q <- quantile(ev, probs = c(.1,.5,.9), names = FALSE)

  spec_list[[i]] <- tibble(
    DesignID = id,
    eig_q10_lam = q[1],
    eig_q50_lam = q[2],
    eig_q90_lam = q[3],
    eig_spread_lam = q[3]/q[1],
    min_eig_lam = min(ev),
    condM_lam = max(ev)/min(ev),
    logdet_lam = sum(log(ev))
  )
}

spec_dist <- bind_rows(spec_list)

# combine with efficiencies
df_spec <- df_all %>%
  left_join(spec_dist, by="DesignID") %>%
  filter(!is.na(condM_lam))

write_csv(df_spec,
 "results_tables1/objective2_design_level_spectrum.csv")

# ============================================================
# PART 2: SUMMARY BY k AND FAMILY (MAIN OBJECTIVE 2 TABLE)
# ============================================================

spec_summary <- df_spec %>%
  group_by(k, family) %>%
  summarise(
    mean_condM = mean(condM_lam),
    mean_logdet = mean(logdet_lam),
    mean_min_eig = mean(min_eig_lam),
    mean_q10 = mean(eig_q10_lam),
    mean_q50 = mean(eig_q50_lam),
    mean_q90 = mean(eig_q90_lam),
    mean_spread = mean(eig_spread_lam),
    .groups="drop"
  )

write_csv(spec_summary,
 "results_tables1/objective2_spectral_summary_by_k_family.csv")

# ============================================================
# PART 3: GROWTH WITH DIMENSION (KEY FOR OBJECTIVE 2)
# ============================================================

growth_fits <- spec_summary %>%
  group_by(family) %>%
  do({

    fit_cond <- lm(log(mean_condM) ~ k, data=. )
    fit_det  <- lm(mean_logdet ~ k, data=. )

    tibble(
      cond_slope = coef(fit_cond)[2],
      cond_r2 = summary(fit_cond)$r.squared,
      logdet_slope = coef(fit_det)[2],
      logdet_r2 = summary(fit_det)$r.squared
    )
  })

write_csv(growth_fits,
 "results_tables1/objective2_growth_rate_models.csv")

# ============================================================
# PART 4: PLOTS (CORE OBJECTIVE 2 FIGURES)
# ============================================================

# eigenvalue quantiles
spec_q_long <- spec_summary %>%
  select(k,family,mean_q10,mean_q50,mean_q90) %>%
  pivot_longer(-c(k,family),
               names_to="quantile",
               values_to="value")

p_q <- ggplot(spec_q_long,
              aes(k,value,color=family,group=family))+
