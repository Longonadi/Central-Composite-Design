  geom_line()+geom_point()+
  theme_minimal(base_size=14)

ggsave("results_figures1/objective2_logdet_growth.png",
       p_det,width=8,height=5)

# ============================================================
# PART 5: LINK SPECTRUM TO EFFICIENCIES
# ============================================================

df_spec <- df_spec %>%
  mutate(log_cond = log(condM_lam))

fit_G <- lm(Geff_cube ~ log_cond + logdet_lam + min_eig_lam  + k + family,
            data=df_spec)

