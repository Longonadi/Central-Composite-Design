library(xgboost)
library(dplyr)
library(ggplot2)
library(readr)

dir.create("results_figures", showWarnings = FALSE, recursive = TRUE)
dir.create("results_tables",  showWarnings = FALSE, recursive = TRUE)

# ----------------------------
# Helpers (DEFINE FIRST)
# ----------------------------
reorder_within <- function(x, by, within, fun = mean, sep = "___", ...){
  new_x <- paste(x, within, sep = sep)
  stats::reorder(new_x, by, FUN = fun)
}

scale_x_reordered <- function(..., sep = "___"){
  ggplot2::scale_x_discrete(
    labels = function(x) sub(paste0(sep, ".*$"), "", x),
    ...
  )
}

# ----------------------------
# Helper: extract + normalise importance
# ----------------------------
get_imp <- function(model, response_name){
  imp <- xgb.importance(model = model)

  imp %>%
    transmute(
      response = response_name,
      Feature  = Feature,
      Gain     = Gain
    ) %>%
    mutate(
      Gain = ifelse(is.na(Gain), 0, Gain),
      Gain_norm = Gain / sum(Gain, na.rm = TRUE)  # sums to 1 within each model
    )
}

# ----------------------------
# Extract importance from your 4 fitted models
# ----------------------------
imp_all <- bind_rows(
  get_imp(xgb_fit_Gcube,   "Geff (cube)"),
  get_imp(xgb_fit_Gsphere, "Geff (sphere)"),
  get_imp(xgb_fitAsphere, "Aeff (sphere)"),
  get_imp(xgb_fitDsphere, "Deff (sphere)")
)

write_csv(imp_all, "results_tables/xgb_importance_combined.csv")

# ----------------------------
# Choose features to show (union of top-N per model)
# ----------------------------
TOP_N <- 12

top_union <- imp_all %>%
  group_by(response) %>%
  slice_max(order_by = Gain_norm, n = TOP_N, with_ties = FALSE) %>%
  ungroup() %>%
  distinct(Feature) %>%
  pull(Feature)

imp_plot <- imp_all %>%
  filter(Feature %in% top_union) %>%
  group_by(response) %>%
  mutate(Feature = reorder_within(Feature, Gain_norm, response)) %>%
  ungroup()

# ----------------------------
# Plot: single combined figure with facets
# ----------------------------
p_combined <- ggplot(imp_plot, aes(x = Feature, y = Gain_norm)) +
  geom_col() +
  coord_flip() +
  facet_wrap(~response, scales = "free_y") +
  labs(
    x = "Predictor",
    y = "Normalised XGBoost importance (Gain)",
    title = "Combined XGBoost variable importance across efficiency criteria and regions"
  ) +
  theme_minimal(base_size = 14) +
  scale_x_reordered()

ggsave(
  "results_figures/xgb_importance_combined_facets.png",
  p_combined, width = 12, height = 7
)

