```{r}
# ---- What this does ----
# Builds the quadratic regression model matrix X for the full second-order model:
# intercept + linear + squares + interactions.
# -------------------------

build_X_quadratic <- function(df){
  vars <- names(df)
  form <- as.formula(paste0(
    "~ ", paste(vars, collapse = " + "),
    " + ", paste0("I(", vars, "^2)", collapse = " + "),
    " + (", paste(vars, collapse = " + "), ")^2"
  ))
  model.matrix(form, data = df)
}

compute_ADG <- function(design_points, region = c("cube","sphere"), g_n = 5000){
 

  X <- build_X_quadratic(design_points)
  p <- ncol(X)
  M <- crossprod(X)

  if(qr(M)$rank < p) return(NULL)
  Minv <- solve(M)

  Dcritical <- det(M)^(1/p)
  Acritical <- sum(diag(Minv))

  k <- ncol(design_points)

  if(region == "cube"){
    Z <- matrix(runif(g_n*k, -1, 1), ncol = k)
  } else {
    Z <- matrix(rnorm(g_n*k), ncol = k)
    Z <- Z / sqrt(rowSums(Z^2))
    r <- runif(g_n)^(1/k) * sqrt(k)
    Z <- Z * r
  }

  colnames(Z) <- colnames(design_points)
  Z <- as.data.frame(Z)

  FZ <- build_X_quadratic(Z)
  Gcritical <- max(rowSums((FZ %*% Minv) * FZ))

  list(Dcritical = Dcritical, Acritical = Acritical, Gcritical = Gcritical)
}
