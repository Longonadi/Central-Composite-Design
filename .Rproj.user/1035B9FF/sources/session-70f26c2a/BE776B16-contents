############################################################
# CCD DESIGN EFFICIENCY ANALYSIS
# Families: FCCD, RCCD, SCCD
# Dimensions: k = 3,...,10
#
# Criteria evaluated:
#   Classical
#   Regularised
#   Scaled Regularised
#
# Metrics:
#   D-efficiency
#   A-efficiency
#   G-efficiency
############################################################

library(dplyr)
library(ggplot2)
library(readr)
library(tibble)
library(FrF2)

dir.create("data_generated", showWarnings = FALSE)
dir.create("Tables", showWarnings = FALSE)
dir.create("Figures", showWarnings = FALSE)

set.seed(6)

############################################################
# CCD GENERATOR
############################################################

make_ccd <- function(k, family, nc, rf, ra){

alpha <- switch(as.character(family),
                "FCCD" = 1,
                "RCCD" = (2^k)^(1/4),
                "SCCD" = sqrt(k))

if(k <= 6){
fac <- as.data.frame(FrF2(nruns = 2^k, nfactors = k))
}else{
fac <- as.data.frame(FrF2(nruns = 32, nfactors = k))
}

fac <- fac[,1:k]
colnames(fac) <- paste0("x",1:k)

fac <- mutate_all(fac, ~ifelse(.==1,1,-1))
fac_rep <- fac[rep(seq_len(nrow(fac)), rf),]

ax <- matrix(0,2*k,k)

for(j in 1:k){
ax[2*j-1,j] <- alpha
ax[2*j,j]   <- -alpha
}

ax <- as.data.frame(ax)
colnames(ax) <- paste0("x",1:k)

ax_rep <- ax[rep(seq_len(nrow(ax)), ra),]

cen <- as.data.frame(matrix(0,nc,k))
colnames(cen) <- paste0("x",1:k)

design_points <- bind_rows(fac_rep, ax_rep, cen)

DesignID <- paste0(family,"_k",k,"_nc",nc,"_rf",rf,"_ra",ra)

meta <- tibble(
DesignID = DesignID,
k = k,
family = family,
nc = nc,
rf = rf,
ra = ra,
alpha = alpha,
N = nrow(design_points)
)

list(points = design_points, meta = meta)

}

############################################################
# BUILD QUADRATIC MODEL MATRIX
############################################################

build_X_quadratic <- function(df){

vars <- names(df)

form <- as.formula(
paste0("~ ",
paste(vars,collapse="+"),
" + ",
paste0("I(",vars,"^2)",collapse="+"),
" + (",
paste(vars,collapse="+"),
")^2")
)

model.matrix(form,data=df)

}

############################################################
# CLASSICAL CRITERIA
############################################################

compute_ADG <- function(design_points, g_n=5000){

X <- build_X_quadratic(design_points)

p <- ncol(X)

M <- crossprod(X)

if(qr(M)$rank < p) return(NULL)

Minv <- solve(M)

Dcrit <- det(M)^(1/p)

Acrit <- sum(diag(Minv))

k <- ncol(design_points)

Z <- matrix(runif(g_n*k,-1,1),ncol=k)
colnames(Z) <- colnames(design_points)
Z <- as.data.frame(Z)

FZ <- build_X_quadratic(Z)

Gcrit <- max(rowSums((FZ %*% Minv) * FZ))

list(Dcrit=Dcrit,Acrit=Acrit,Gcrit=Gcrit)

}

############################################################
# REGULARISED CRITERIA
############################################################

compute_ADG_reg <- function(design_points, lambda=0.01, g_n=5000){

X <- build_X_quadratic(design_points)

p <- ncol(X)

M <- crossprod(X)

Mlam <- M + lambda*diag(p)

Minv <- solve(Mlam)

Dcrit <- det(Mlam)^(1/p)

Acrit <- sum(diag(Minv))

k <- ncol(design_points)

Z <- matrix(runif(g_n*k,-1,1),ncol=k)
colnames(Z) <- colnames(design_points)
Z <- as.data.frame(Z)

FZ <- build_X_quadratic(Z)

Gcrit <- max(rowSums((FZ %*% Minv) * FZ))

list(Dcrit=Dcrit,Acrit=Acrit,Gcrit=Gcrit)

}

############################################################
# SCALED REGULARISED CRITERIA
############################################################

compute_ADG_scaled <- function(design_points, lambda=0.01, g_n=5000){

X <- build_X_quadratic(design_points)

p <- ncol(X)

M <- crossprod(X)

scale_factor <- mean(diag(M))

Mscaled <- (M + lambda*diag(p)) / scale_factor

Minv <- solve(Mscaled)

Dcrit <- det(Mscaled)^(1/p)

Acrit <- sum(diag(Minv))

k <- ncol(design_points)

Z <- matrix(runif(g_n*k,-1,1),ncol=k)
colnames(Z) <- colnames(design_points)
Z <- as.data.frame(Z)

FZ <- build_X_quadratic(Z)

Gcrit <- max(rowSums((FZ %*% Minv) * FZ))

list(Dcrit=Dcrit,Acrit=Acrit,Gcrit=Gcrit)

}

############################################################
# PARAMETER GRID
############################################################

k_grid   <- 3:10
families <- c("FCCD","RCCD","SCCD")
nc_grid  <- c(1,3,5,7,10)
rf_grid  <- c(1,2,3)
ra_grid  <- c(1,2,3)

grid <- expand.grid(
k = k_grid,
family = families,
nc = nc_grid,
rf = rf_grid,
ra = ra_grid,
stringsAsFactors = FALSE
)

############################################################
# GENERATE DESIGNS
############################################################

meta_list <- vector("list", nrow(grid))

for(i in seq_len(nrow(grid))){

row <- grid[i,]

out <- make_ccd(row$k,row$family,row$nc,row$rf,row$ra)

meta_list[[i]] <- out$meta

saveRDS(
out$points,
file.path("data_generated",
paste0("design_",out$meta$DesignID,".rds"))
)

}

design_metadata <- bind_rows(meta_list)

write_csv(design_metadata,
"data_generated/design_metadata.csv")

############################################################
# COMPUTE CRITERIA
############################################################

meta <- read_csv("data_generated/design_metadata.csv")

out_list <- vector("list", nrow(meta))

for(i in seq_len(nrow(meta))){

id <- meta$DesignID[i]

pts <- readRDS(file.path("data_generated",
paste0("design_",id,".rds")))

crit_classical <- compute_ADG(pts)

crit_reg <- compute_ADG_reg(pts)

crit_scaled <- compute_ADG_scaled(pts)

if(is.null(crit_classical)) next

out_list[[i]] <- tibble(
DesignID = id,

D_classical = crit_classical$Dcrit,
A_classical = crit_classical$Acrit,
G_classical = crit_classical$Gcrit,

D_reg = crit_reg$Dcrit,
A_reg = crit_reg$Acrit,
G_reg = crit_reg$Gcrit,

D_scaled = crit_scaled$Dcrit,
A_scaled = crit_scaled$Acrit,
G_scaled = crit_scaled$Gcrit
)

}

mycriteria_raw <- bind_rows(out_list)

write_csv(mycriteria_raw,
"data_generated/mycriteria_raw.csv")

############################################################
# CONVERT TO EFFICIENCIES
############################################################

df <- meta %>% inner_join(mycriteria_raw,by="DesignID")

mycriteria_eff <- df %>%
group_by(k) %>%
mutate(

Deff_classical = D_classical/max(D_classical),
Aeff_classical = min(A_classical)/A_classical,
Geff_classical = min(G_classical)/G_classical,

Deff_reg = D_reg/max(D_reg),
Aeff_reg = min(A_reg)/A_reg,
Geff_reg = min(G_reg)/G_reg,

Deff_scaled = D_scaled/max(D_scaled),
Aeff_scaled = min(A_scaled)/A_scaled,
Geff_scaled = min(G_scaled)/G_scaled

) %>%
ungroup()

write_csv(mycriteria_eff,
"data_generated/mycriteria_eff.csv")

############################################################
# MEAN EFFICIENCIES
############################################################

tab_mean <- mycriteria_eff %>%
group_by(k,family) %>%
summarise(

meanG_classical = mean(Geff_classical),
meanG_reg = mean(Geff_reg),
meanG_scaled = mean(Geff_scaled),

meanD_classical = mean(Deff_classical),
meanD_reg = mean(Deff_reg),
meanD_scaled = mean(Deff_scaled),

meanA_classical = mean(Aeff_classical),
meanA_reg = mean(Aeff_reg),
meanA_scaled = mean(Aeff_scaled),

.groups="drop"

)

write_csv(tab_mean,
"Tables/mean_eff_by_k_family.csv")

############################################################
# PLOTS
############################################################

plot_eff <- function(dat,ycol,ylab,file){

p <- ggplot(dat,
aes(x=k,y=.data[[ycol]],
color=family,
linetype=family,
shape=family,
group=family))+
geom_line(linewidth=1.1)+
geom_point(size=3)+
theme_minimal(base_size=14)+
labs(x="Number of factors (k)",
y=ylab,
color="CCD family")

ggsave(file,p,width=8,height=5)

p
}

# Classical
plot_eff(tab_mean,"meanG_classical",
"Mean G-efficiency (Classical)",
"Figures/G_classical.png")

plot_eff(tab_mean,"meanD_classical",
"Mean D-efficiency (Classical)",
"Figures/D_classical.png")

plot_eff(tab_mean,"meanA_classical",
"Mean A-efficiency (Classical)",
"Figures/A_classical.png")

# Regularised
plot_eff(tab_mean,"meanG_reg",
"Mean G-efficiency (Regularised)",
"Figures/G_regularised.png")

plot_eff(tab_mean,"meanD_reg",
"Mean D-efficiency (Regularised)",
"Figures/D_regularised.png")

plot_eff(tab_mean,"meanA_reg",
"Mean A-efficiency (Regularised)",
"Figures/A_regularised.png")

# Scaled Regularised
plot_eff(tab_mean,"meanG_scaled",
"Mean G-efficiency (Scaled Regularised)",
"Figures/G_scaled.png")

plot_eff(tab_mean,"meanD_scaled",
"Mean D-efficiency (Scaled Regularised)",
"Figures/D_scaled.png")

plot_eff(tab_mean,"meanA_scaled",
"Mean A-efficiency (Scaled Regularised)",
"Figures/A_scaled.png")
