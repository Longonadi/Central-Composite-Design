## Part D — Select Best Lambda

```{r obj1-reg-best-lambda}
lambda_summary <- mycriteria_eff_by_lambda %>%
  dplyr::mutate(
    G_overall = (Geff_cube + Geff_sphere) / 2,
    D_overall = (Deff_cube + Deff_sphere) / 2,
    A_overall = (Aeff_cube + Aeff_sphere) / 2
  ) %>%
  dplyr::group_by(lambda) %>%
  dplyr::summarise(
    meanG = mean(G_overall, na.rm = TRUE),
