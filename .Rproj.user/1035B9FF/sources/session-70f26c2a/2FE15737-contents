## Part B — Grid Search for Optimal Lambda

A grid of nine candidate values $\lambda \in \{10^{-10}, \ldots, 10^{-2}\}$
is evaluated. The value that maximises mean G-efficiency (averaged over
both regions and all $k$) is selected as $\lambda^*$.

```{r obj1-reg-lambda-search}
lambda_grid <- 10^seq(-10, -2, by = 1)
G_N         <- 5000

meta_reg <- readr::read_csv("data_generated/design_metadata_reg.csv") %>%
  dplyr::mutate(DesignID = stringr::str_trim(DesignID))

raw_by_lam <- list()
idx        <- 1L

for (lam in lambda_grid) {
  for (i in seq_len(nrow(meta_reg))) {
    id    <- meta_reg$DesignID[i]
    fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
    if (!file.exists(fpath)) next

    pts       <- readRDS(fpath)
    crit_cube <- compute_ADG_reg(pts, "cube",   g_n = G_N, lambda = lam)
    crit_sph  <- compute_ADG_reg(pts, "sphere", g_n = G_N, lambda = lam)
    if (is.null(crit_cube) || is.null(crit_sph)) next

    raw_by_lam[[idx]] <- tibble::tibble(
      DesignID         = id,
      lambda           = lam,
      Dcritical_cube   = crit_cube$Dcrit,
      Acritical_cube   = crit_cube$Acrit,
      Gcritical_cube   = crit_cube$Gcrit,
      Dcritical_sphere = crit_sph$Dcrit,
      Acritical_sphere = crit_sph$Acrit,
      Gcritical_sphere = crit_sph$Gcrit
    )
    idx <- idx + 1L
  }
}

mycriteria_raw_by_lambda <- dplyr::bind_rows(raw_by_lam)
readr::write_csv(mycriteria_raw_by_lambda,
                 "data_generated/mycriteria_raw_by_lambda.csv")
```

## Part C — Compute Relative Efficiencies Within (lambda, k)

```{r obj1-reg-efficiencies}
