# ── XGBoost importance extraction + normalisation ─────────────────────────────
get_xgb_importance <- function(model, response_label) {
  xgb.importance(model = model) %>%
    transmute(
      response  = response_label,
      Feature   = Feature,
      Gain      = ifelse(is.na(Gain), 0, Gain)
    ) %>%
    mutate(Gain_norm = Gain / sum(Gain, na.rm = TRUE))
}

