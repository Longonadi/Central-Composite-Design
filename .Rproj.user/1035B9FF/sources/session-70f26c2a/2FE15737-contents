# Objective 5: Multi-Class Classification of CCD Family

```{r obj5-classification}
# ── Predictor set for classification ─────────────────────────────────────────
Xvars_cls <- c(
  "k", "nc", "rf", "ra", "alpha", "N", "Nf", "Na", "Nc",
  "log_condM_lam", "min_eig_lam", "logdet_lam",
  "eig_q10_lam", "eig_q50_lam", "eig_q90_lam", "eig_spread_lam"
)
Xvars_cls <- Xvars_cls[Xvars_cls %in% names(df_all)]

model_df_cls <- df_all %>%
  dplyr::select(family, dplyr::all_of(Xvars_cls)) %>%
  dplyr::filter(complete.cases(.)) %>%
  dplyr::mutate(family = factor(family))

# ── Stratified 80/20 train-test split ────────────────────────────────────────
split_cls <- rsample::initial_split(model_df_cls,
                                    prop    = 0.8,
                                    strata  = family)
train_cls <- rsample::training(split_cls)
test_cls  <- rsample::testing(split_cls)

# ── Stratified 5-fold CV folds ───────────────────────────────────────────────
folds_cls <- rsample::vfold_cv(train_cls, v = 5, strata = family)

# ── Pre-processing recipe ─────────────────────────────────────────────────────
rec_cls <- recipes::recipe(family ~ ., data = train_cls) %>%
  recipes::step_zv(recipes::all_predictors()) %>%
  recipes::step_normalize(recipes::all_numeric_predictors())

cls_metrics <- yardstick::metric_set(yardstick::accuracy)

# ── Model specifications ──────────────────────────────────────────────────────
rf_cls_spec <- parsnip::rand_forest(
  mode  = "classification",
  trees = 800L,
  mtry  = tune::tune(),
  min_n = tune::tune()
) %>% parsnip::set_engine("ranger", importance = "permutation")

mlog_spec <- parsnip::multinom_reg(mode = "classification") %>%
  parsnip::set_engine("nnet")

xgb_cls_spec <- parsnip::boost_tree(
  mode         = "classification",
  trees        = tune::tune(),
  tree_depth   = tune::tune(),
  learn_rate   = tune::tune(),
  mtry         = tune::tune(),
  min_n        = tune::tune(),
  loss_reduction = tune::tune(),
  sample_size  = tune::tune()
) %>% parsnip::set_engine("xgboost")

svm_cls_spec <- parsnip::svm_rbf(
  mode      = "classification",
  cost      = tune::tune(),
  rbf_sigma = tune::tune()
) %>% parsnip::set_engine("kernlab")

# ── Workflows ─────────────────────────────────────────────────────────────────
wf_rf_cls   <- workflows::workflow() %>%
  workflows::add_recipe(rec_cls) %>%
  workflows::add_model(rf_cls_spec)

wf_mlog_cls <- workflows::workflow() %>%
  workflows::add_recipe(rec_cls) %>%
  workflows::add_model(mlog_spec)

wf_xgb_cls  <- workflows::workflow() %>%
  workflows::add_recipe(rec_cls) %>%
  workflows::add_model(xgb_cls_spec)

wf_svm_cls  <- workflows::workflow() %>%
  workflows::add_recipe(rec_cls) %>%
  workflows::add_model(svm_cls_spec)

# ── Tuning grids ──────────────────────────────────────────────────────────────
rf_cls_grid <- dials::grid_regular(
  dials::mtry(range = c(2L, max(2L, length(Xvars_cls)))),
  dials::min_n(range = c(2L, 20L)),
  levels = 5L
)

xgb_cls_grid <- dials::grid_latin_hypercube(
  dials::trees(range        = c(200L,  1200L)),
  dials::tree_depth(range   = c(2L,    8L)),
  dials::learn_rate(range   = c(0.01,  0.3)),
  dials::mtry(range         = c(2L,    max(2L, length(Xvars_cls)))),
  dials::min_n(range        = c(2L,    30L)),
  dials::loss_reduction(),
  sample_size = dials::sample_prop(),
  size = 25L
)

svm_cls_grid <- dials::grid_regular(
  dials::cost(range      = c(-3, 3)),
  dials::rbf_sigma(range = c(-5, 0)),
  levels = 7L
)

# ── Cross-validated fitting ───────────────────────────────────────────────────
rf_cls_res   <- tune::tune_grid(wf_rf_cls,  folds_cls,
                                grid = rf_cls_grid,  metrics = cls_metrics)
mlog_cls_res <- tune::fit_resamples(wf_mlog_cls, folds_cls,
                                    metrics = cls_metrics)
xgb_cls_res  <- tune::tune_grid(wf_xgb_cls, folds_cls,
                                grid = xgb_cls_grid, metrics = cls_metrics)
svm_cls_res  <- tune::tune_grid(wf_svm_cls, folds_cls,
                                grid = svm_cls_grid, metrics = cls_metrics)

# ── Finalise workflows on full training set ───────────────────────────────────
final_rf_cls   <- tune::finalize_workflow(
  wf_rf_cls,  tune::select_best(rf_cls_res,  "accuracy")) %>%
  parsnip::fit(train_cls)

final_mlog_cls <- parsnip::fit(wf_mlog_cls, data = train_cls)

final_xgb_cls  <- tune::finalize_workflow(
  wf_xgb_cls, tune::select_best(xgb_cls_res, "accuracy")) %>%
  parsnip::fit(train_cls)

final_svm_cls  <- tune::finalize_workflow(
  wf_svm_cls, tune::select_best(svm_cls_res, "accuracy")) %>%
  parsnip::fit(train_cls)

# ── CV accuracy summary ───────────────────────────────────────────────────────
cv_acc_summary <- dplyr::bind_rows(
  tune::collect_metrics(rf_cls_res)   %>%
    dplyr::filter(.metric == "accuracy") %>%
    dplyr::mutate(model = "Random Forest"),
  tune::collect_metrics(mlog_cls_res) %>%
    dplyr::filter(.metric == "accuracy") %>%
    dplyr::mutate(model = "Multinomial Logistic"),
  tune::collect_metrics(xgb_cls_res)  %>%
    dplyr::filter(.metric == "accuracy") %>%
    dplyr::mutate(model = "XGBoost"),
  tune::collect_metrics(svm_cls_res)  %>%
    dplyr::filter(.metric == "accuracy") %>%
    dplyr::mutate(model = "SVM-RBF")
) %>%
  dplyr::select(model, mean, std_err, n) %>%
  dplyr::arrange(dplyr::desc(mean))

readr::write_csv(cv_acc_summary,
  "results_tables4/objective5_CV_accuracy_summary.csv")

# ── Test-set confusion matrices and accuracy ──────────────────────────────────
eval_classifier <- function(fitted_wf, test_df, model_name) {
  preds <- predict(fitted_wf, test_df, type = "class") %>%
    dplyr::bind_cols(test_df %>% dplyr::select(family))

  list(
    model    = model_name,
    accuracy = yardstick::accuracy(preds,
                 truth    = family,
                 estimate = .pred_class),
    conf_mat = yardstick::conf_mat(preds,
                 truth    = family,
                 estimate = .pred_class)
  )
}

res_rf_cls   <- eval_classifier(final_rf_cls,   test_cls, "Random Forest")
res_mlog_cls <- eval_classifier(final_mlog_cls, test_cls, "Multinomial Logistic")
res_xgb_cls  <- eval_classifier(final_xgb_cls,  test_cls, "XGBoost")
res_svm_cls  <- eval_classifier(final_svm_cls,  test_cls, "SVM-RBF")

# Print results
cat("\n=== Test-set Classification Results ===\n")
for (res in list(res_rf_cls, res_mlog_cls, res_xgb_cls, res_svm_cls)) {
  cat(res$model, "| Accuracy:",
      round(res$accuracy$.estimate, 4), "\n")
  print(res$conf_mat)
  cat("\n")
}
