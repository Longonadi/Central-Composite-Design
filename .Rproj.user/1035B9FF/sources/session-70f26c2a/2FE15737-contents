# Shared Helper Functions

These functions are defined once and used throughout all objectives.

## CCD Design Generator (`make_ccd`)

Constructs a Central Composite Design for a given family (FCCD, RCCD, or
SCCD), number of factors $k$, center-point count $n_c$, and replication
counts $r_f$ and $r_\alpha$.  
For $k \leq 5$ a full $2^k$ factorial core is used; for $k \geq 6$ the
factorial run count is fixed at 32 to simulate a realistic budget
constraint (see Section 3.2.5 of the main text).

```{r fn-make-ccd}
make_ccd <- function(k, family, nc, rf, ra) {

  # ── Axial distance by design family ─────────────────────────────────────────
  alpha <- switch(family,
    FCCD = 1,
    RCCD = (2^k)^(1/4),   # rotatability condition
    SCCD = sqrt(k),        # spherical condition
    stop("Unknown family: must be one of FCCD, RCCD, SCCD")
  )

  # ── Factorial core ───────────────────────────────────────────────────────────
  # k <= 5: full 2^k factorial
  # k >= 6: fixed at 32 runs (budget constraint)
  nf_runs <- if (k <= 5) 2^k else 32L
  fac <- as.data.frame(FrF2::FrF2(nruns = nf_runs, nfactors = k))
  fac <- fac[, 1:k, drop = FALSE]
  colnames(fac) <- paste0("x", seq_len(k))
  fac <- dplyr::mutate_all(fac, ~ ifelse(. == 1, 1, -1))

  # Replicate factorial points rf times
  fac_rep <- fac[rep(seq_len(nrow(fac)), times = rf), , drop = FALSE]

  # ── Axial (star) points: 2k points at ±alpha along each axis ────────────────
  ax <- matrix(0, nrow = 2 * k, ncol = k)
  for (j in seq_len(k)) {
    ax[2 * j - 1, j] <-  alpha
    ax[2 * j,     j] <- -alpha
  }
  ax <- as.data.frame(ax)
  colnames(ax) <- paste0("x", seq_len(k))

  # Replicate axial points ra times
  ax_rep <- ax[rep(seq_len(nrow(ax)), times = ra), , drop = FALSE]

  # ── Center points ────────────────────────────────────────────────────────────
  cen <- as.data.frame(matrix(0, nrow = nc, ncol = k))
  colnames(cen) <- paste0("x", seq_len(k))

  # ── Combine all components ───────────────────────────────────────────────────
  design_points <- dplyr::bind_rows(fac_rep, ax_rep, cen)

  # ── Unique design identifier ─────────────────────────────────────────────────
  DesignID <- paste0(family, "_k", k, "_nc", nc,
                     "_rf", rf, "_ra", ra, "_full")

  # ── Metadata tibble ──────────────────────────────────────────────────────────
  meta <- tibble::tibble(
    DesignID = DesignID,
    k        = k,
    family   = family,
    nc       = nc,
    rf       = rf,
    ra       = ra,
    core     = "full",
    alpha    = alpha,
    N        = nrow(design_points),
    Nf       = nrow(fac_rep),
    Na       = nrow(ax_rep),
    Nc       = nrow(cen)
  )

  list(points = design_points, meta = meta)
}
```

## Quadratic Model Matrix Builder (`build_X_quadratic`)

Constructs the full second-order response surface model matrix
$\mathbf{X}$ with intercept, $k$ linear terms, $k$ pure quadratic terms,
and $k(k-1)/2$ two-factor interaction terms.

```{r fn-build-X}
build_X_quadratic <- function(df) {
  vars <- names(df)
  form <- as.formula(paste0(
    "~ ",
    paste(vars, collapse = " + "),
    " + ",
    paste0("I(", vars, "^2)", collapse = " + "),
    " + (",
    paste(vars, collapse = " + "),
    ")^2"
  ))
  model.matrix(form, data = df)
}
```

## Log-Determinant via Cholesky Decomposition (`logdet_pd`)

Computes $\log|M_\lambda|$ numerically stably using the Cholesky factor:
$\log|M_\lambda| = 2 \sum_j \log R_{jj}$.

```{r fn-logdet}
logdet_pd <- function(Mpd) {
  R <- chol(Mpd)
  2 * sum(log(diag(R)))
}
```

## Unregularised Optimality Criteria (`compute_ADG`)

Used for $k \leq 6$ where $M = X^\prime X$ is non-singular.  
G-efficiency is approximated via Monte Carlo with `g_n = 5000` random
points drawn from either the cube $[-1,1]^k$ or the sphere of radius
$\sqrt{k}$.

```{r fn-compute-ADG}
compute_ADG <- function(design_points,
                        region = c("cube", "sphere"),
                        g_n    = 5000) {
  region <- match.arg(region)

  X <- build_X_quadratic(design_points)
  p <- ncol(X)
  M <- crossprod(X)

  # Return NULL for rank-deficient matrices (excluded from analysis)
  if (qr(M)$rank < p) return(NULL)
  Minv <- solve(M)

  Dcritical <- det(M)^(1 / p)
  Acritical <- sum(diag(Minv))

  k <- ncol(design_points)

  # Monte Carlo sample from the experimental region
  if (region == "cube") {
    Z <- matrix(runif(g_n * k, -1, 1), ncol = k)
  } else {
    # Uniform sample inside sphere of radius sqrt(k)
    Z <- matrix(rnorm(g_n * k), ncol = k)
    Z <- Z / sqrt(rowSums(Z^2))            # project to unit sphere
    r <- runif(g_n)^(1 / k) * sqrt(k)     # radial scaling
    Z <- Z * r
  }

  colnames(Z) <- colnames(design_points)
  Z           <- as.data.frame(Z)
  FZ          <- build_X_quadratic(Z)

  # Maximum scaled prediction variance
  Gcritical <- max(rowSums((FZ %*% Minv) * FZ))

  list(Dcritical = Dcritical, Acritical = Acritical, Gcritical = Gcritical)
}
```

## Regularised Optimality Criteria (`compute_ADG_reg`)

Used for all $k = 3, \ldots, 10$ with $M_\lambda = X^\prime X + \lambda I$.
The Cholesky decomposition is used for both the log-determinant and the
matrix inverse to ensure numerical stability.

```{r fn-compute-ADG-reg}
compute_ADG_reg <- function(design_points,
                            region = c("cube", "sphere"),
                            g_n    = 5000,
                            lambda = 1e-2) {
  region <- match.arg(region)

  X <- build_X_quadratic(design_points)
  p <- ncol(X)
  M <- crossprod(X)

  # Ridge-regularised information matrix
  Mlam <- M + diag(lambda, p)

  # Cholesky factorisation (returns NULL if not positive definite)
  R <- tryCatch(chol(Mlam), error = function(e) NULL)
  if (is.null(R)) return(NULL)

  Mlam_inv <- chol2inv(R)

  # Regularised criteria
  Dcrit <- exp(logdet_pd(Mlam) / p)
  Acrit <- sum(diag(Mlam_inv))

  k <- ncol(design_points)

  # Monte Carlo sample
  if (region == "cube") {
    Z <- matrix(runif(g_n * k, -1, 1), ncol = k)
  } else {
    Z <- matrix(rnorm(g_n * k), ncol = k)
    Z <- Z / sqrt(rowSums(Z^2))
    r <- runif(g_n)^(1 / k) * sqrt(k)
    Z <- Z * r
  }

  colnames(Z) <- colnames(design_points)
  Z           <- as.data.frame(Z)
  FZ          <- build_X_quadratic(Z)

  vx    <- rowSums((FZ %*% Mlam_inv) * FZ)
  Gcrit <- max(vx)

  list(Dcrit = Dcrit, Acrit = Acrit, Gcrit = Gcrit)
}
```

## Machine Learning Helper Functions

```{r fn-ml-helpers}
# ── Performance metrics (RMSE and R-squared) ──────────────────────────────────
reg_metrics <- function(y_true, y_pred) {
  rmse <- sqrt(mean((y_pred - y_true)^2))
  r2   <- 1 - sum((y_pred - y_true)^2) /
              sum((y_true - mean(y_true))^2)
  c(rmse = rmse, r2 = r2)
}

# ── Observed-vs-predicted scatter plot ───────────────────────────────────────
save_obs_pred_plot <- function(y_true, y_pred, model_name, outdir) {
  p <- ggplot(
    data.frame(Observed = y_true, Predicted = y_pred),
    aes(x = Observed, y = Predicted)
  ) +
    geom_point(alpha = 0.45, size = 1.5) +
    geom_abline(slope = 1, intercept = 0,
