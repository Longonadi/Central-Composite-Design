# Objective 2: Spectral Characterisation of Information Matrices

## Part 1 — Extract Spectral Features

For each design configuration, eigenvalues of $M_\lambda$ are computed and
the following spectral quantities are recorded: minimum eigenvalue
$\lambda_{\min}$, condition number $\kappa(M_\lambda)$, log-determinant
$\log|M_\lambda|$, and eigenvalue quantiles $q_{10}$, $q_{50}$, $q_{90}$.

```{r obj2-spectral-features}
lambda_sp <- 1e-2   # optimal lambda from Objective 1

spec_list <- vector("list", nrow(meta_reg))

for (i in seq_len(nrow(meta_reg))) {
  id    <- meta_reg$DesignID[i]
  fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
  if (!file.exists(fpath)) next

  pts  <- readRDS(fpath)
  X    <- build_X_quadratic(pts)
  p    <- ncol(X)
  Mlam <- crossprod(X) + lambda_sp * diag(p)

  ev <- sort(
    eigen(Mlam, symmetric = TRUE, only.values = TRUE)$values
  )
  ev <- ev[is.finite(ev) & ev > 0]
  if (length(ev) < 5) next

  q <- quantile(ev, probs = c(0.10, 0.50, 0.90), names = FALSE)

  spec_list[[i]] <- tibble::tibble(
    DesignID       = id,
    eig_q10_lam    = q[1],
    eig_q50_lam    = q[2],
    eig_q90_lam    = q[3],
    eig_spread_lam = q[3] / q[1],          # q90 / q10 spread
    min_eig_lam    = min(ev),
    condM_lam      = max(ev) / min(ev),    # condition number
    logdet_lam     = sum(log(ev))          # log-determinant
  )
}

spec_dist <- dplyr::bind_rows(spec_list)

# Join spectral features with efficiency data
df_spec <- df_all %>%
  dplyr::left_join(spec_dist, by = "DesignID") %>%
  dplyr::filter(!is.na(condM_lam)) %>%
  dplyr::mutate(log_cond = log(condM_lam))

readr::write_csv(df_spec,
                 "results_tables1/objective2_design_level_spectrum.csv")
```

