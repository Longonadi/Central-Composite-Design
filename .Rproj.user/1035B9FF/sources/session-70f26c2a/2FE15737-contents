## Part B — Compute Unregularised D-, A-, G-Criteria

```{r obj1-unr-criteria}
meta_unr <- readr::read_csv("data_generated2/design_metadata_unr.csv")
out_list_unr <- vector("list", nrow(meta_unr))

for (i in seq_len(nrow(meta_unr))) {
  id  <- meta_unr$DesignID[i]
  pts <- readRDS(file.path("data_generated2",
                           paste0("design_", id, ".rds")))

  crit_cube <- compute_ADG(pts, "cube",   g_n = 5000)
  crit_sph  <- compute_ADG(pts, "sphere", g_n = 5000)

  if (is.null(crit_cube) || is.null(crit_sph)) next

  out_list_unr[[i]] <- tibble::tibble(
    DesignID         = id,
    Dcritical_cube   = crit_cube$Dcritical,
    Acritical_cube   = crit_cube$Acritical,
    Gcritical_cube   = crit_cube$Gcritical,
    Dcritical_sphere = crit_sph$Dcritical,
    Acritical_sphere = crit_sph$Acritical,
    Gcritical_sphere = crit_sph$Gcritical
  )
}

mycriteria_raw_unr <- dplyr::bind_rows(out_list_unr)
readr::write_csv(mycriteria_raw_unr,
                 "data_generated2/mycriteria_raw_unr.csv")
```

## Part C — Convert to Relative Efficiencies (Within Each k)

Relative efficiencies are computed by normalising within each dimension $k$
so that the best-performing design at each $k$ receives an efficiency of 1.

```{r obj1-unr-efficiencies}
df_unr <- meta_unr %>%
  dplyr::inner_join(mycriteria_raw_unr, by = "DesignID")

mycriteria_eff_unr <- df_unr %>%
  dplyr::group_by(k) %>%
  dplyr::mutate(
    # D-efficiency: higher determinant is better
    Defficiency_cube   = Dcritical_cube   / max(Dcritical_cube,   na.rm = TRUE),
    Defficiency_sphere = Dcritical_sphere / max(Dcritical_sphere, na.rm = TRUE),
    # A-efficiency: lower trace(M^-1) is better
    Aefficiency_cube   = min(Acritical_cube,   na.rm = TRUE) / Acritical_cube,
    Aefficiency_sphere = min(Acritical_sphere, na.rm = TRUE) / Acritical_sphere,
    # G-efficiency: lower max prediction variance is better
    Gefficiency_cube   = min(Gcritical_cube,   na.rm = TRUE) / Gcritical_cube,
    Gefficiency_sphere = min(Gcritical_sphere, na.rm = TRUE) / Gcritical_sphere
  ) %>%
  dplyr::ungroup()

readr::write_csv(mycriteria_eff_unr,
                 "data_generated2/mycriteria_eff_unr.csv")
```

