# Objective 4: Machine Learning Validation

A reusable function `run_ml_models()` fits all eight algorithms for a given
response variable and returns a performance table and the fitted XGBoost
model object (for subsequent importance extraction).

```{r obj4-ml-function}
run_ml_models <- function(df_all,
                          response,
                          xvars_candidate,
                          out_dir_figs = "results_figures4",
                          out_dir_tabs = "results_tables4",
                          n_trees_rf   = 800L,
                          xgb_rounds   = 600L,
                          knn_k        = 15L) {

  # ── Filter to available predictors ──────────────────────────────────────────
  Xvars <- xvars_candidate[xvars_candidate %in% names(df_all)]

  model_df <- df_all %>%
    dplyr::filter(
      complete.cases(dplyr::across(dplyr::all_of(c(Xvars, response))))
    )

  cat("Response:", response, "| Rows:", nrow(model_df),
      "| Predictors:", length(Xvars), "\n")

  # ── 80 / 20 train-test split ─────────────────────────────────────────────────
  idx     <- sample(seq_len(nrow(model_df)), floor(0.8 * nrow(model_df)))
  train   <- model_df[ idx, ]
  test    <- model_df[-idx, ]

  x_train <- as.matrix(train[, Xvars])
  x_test  <- as.matrix(test[,  Xvars])
  y_train <- train[[response]]
  y_test  <- test[[response]]

  # Standardised versions for SVR and KNN
  x_train_sc <- scale(x_train)
  x_test_sc  <- scale(x_test,
    center = attr(x_train_sc, "scaled:center"),
    scale  = attr(x_train_sc, "scaled:scale"))

  metrics_out <- list()
  xgb_model   <- NULL

  # ── Model 1: Ordinary Least Squares ─────────────────────────────────────────
  fit_lm <- lm(
    as.formula(paste(response, "~ .")),
    data = train[, c(response, Xvars)]
  )
  pred <- predict(fit_lm, newdata = test)
  metrics_out[["LM"]] <- data.frame(
    model = "Linear Regression",
    rmse  = reg_metrics(y_test, pred)["rmse"],
    r2    = reg_metrics(y_test, pred)["r2"]
  )
  save_obs_pred_plot(y_test, pred,
    paste0("LM_",        response), out_dir_figs)

  # ── Model 2: Ridge Regression ────────────────────────────────────────────────
  cv_ridge <- glmnet::cv.glmnet(x_train, y_train, alpha = 0)
  pred     <- as.numeric(predict(cv_ridge, x_test, s = "lambda.min"))
  metrics_out[["Ridge"]] <- data.frame(
    model = "Ridge",
    rmse  = reg_metrics(y_test, pred)["rmse"],
    r2    = reg_metrics(y_test, pred)["r2"]
  )
  save_obs_pred_plot(y_test, pred,
    paste0("Ridge_",     response), out_dir_figs)

  # ── Model 3: Lasso ───────────────────────────────────────────────────────────
  cv_lasso <- glmnet::cv.glmnet(x_train, y_train, alpha = 1)
  pred     <- as.numeric(predict(cv_lasso, x_test, s = "lambda.min"))
  metrics_out[["Lasso"]] <- data.frame(
    model = "Lasso",
    rmse  = reg_metrics(y_test, pred)["rmse"],
    r2    = reg_metrics(y_test, pred)["r2"]
  )
  save_obs_pred_plot(y_test, pred,
    paste0("Lasso_",     response), out_dir_figs)

  # ── Model 4: Elastic Net (alpha = 0.5) ───────────────────────────────────────
  cv_enet <- glmnet::cv.glmnet(x_train, y_train, alpha = 0.5)
  pred    <- as.numeric(predict(cv_enet, x_test, s = "lambda.min"))
  metrics_out[["ElasticNet"]] <- data.frame(
    model = "Elastic Net",
    rmse  = reg_metrics(y_test, pred)["rmse"],
    r2    = reg_metrics(y_test, pred)["r2"]
  )
  save_obs_pred_plot(y_test, pred,
    paste0("ElasticNet_", response), out_dir_figs)

  # ── Model 5: Random Forest ───────────────────────────────────────────────────
  rf   <- ranger::ranger(
    formula    = as.formula(paste(response, "~ .")),
    data       = train[, c(response, Xvars)],
    num.trees  = n_trees_rf,
    importance = "permutation"
  )
  pred <- predict(rf, data = test[, Xvars])$predictions
  metrics_out[["RF"]] <- data.frame(
    model = "Random Forest",
    rmse  = reg_metrics(y_test, pred)["rmse"],
    r2    = reg_metrics(y_test, pred)["r2"]
  )
  save_obs_pred_plot(y_test, pred,
    paste0("RF_",        response), out_dir_figs)

  p_imp <- vip::vip(rf, num_features = 12) +
    ggplot2::ggtitle(paste("RF Variable Importance:", response))
  ggplot2::ggsave(
    file.path(out_dir_figs, paste0("importance_RF_", response, ".png")),
    p_imp, width = 8, height = 5
  )

  # ── Model 6: XGBoost ─────────────────────────────────────────────────────────
  dtrain    <- xgboost::xgb.DMatrix(data = x_train, label = y_train)
  dtest     <- xgboost::xgb.DMatrix(data = x_test,  label = y_test)

  xgb_params <- list(
    objective        = "reg:squarederror",
    eval_metric      = "rmse",
    max_depth        = 5L,
    eta              = 0.06,
    subsample        = 0.8,
    colsample_bytree = 0.8
  )

  xgb_model <- xgboost::xgb.train(
    params  = xgb_params,
    data    = dtrain,
    nrounds = xgb_rounds,
    verbose = 0
  )

  pred <- predict(xgb_model, dtest)
  metrics_out[["XGB"]] <- data.frame(
    model = "XGBoost",
    rmse  = reg_metrics(y_test, pred)["rmse"],
    r2    = reg_metrics(y_test, pred)["r2"]
  )
  save_obs_pred_plot(y_test, pred,
    paste0("XGBoost_",   response), out_dir_figs)

  # ── Model 7: Support Vector Regression (RBF kernel) ──────────────────────────
  svr  <- e1071::svm(x = x_train_sc, y = y_train,
                     type   = "eps-regression",
                     kernel = "radial")
  pred <- predict(svr, x_test_sc)
  metrics_out[["SVR"]] <- data.frame(
    model = "SVR",
    rmse  = reg_metrics(y_test, pred)["rmse"],
    r2    = reg_metrics(y_test, pred)["r2"]
  )
  save_obs_pred_plot(y_test, pred,
    paste0("SVR_",       response), out_dir_figs)

  # ── Model 8: K-Nearest Neighbours (K = 15) ───────────────────────────────────
  knn  <- FNN::knn.reg(train = x_train_sc, test = x_test_sc,
                       y = y_train, k = knn_k)
  pred <- knn$pred
  metrics_out[["KNN"]] <- data.frame(
    model = "KNN",
    rmse  = reg_metrics(y_test, pred)["rmse"],
    r2    = reg_metrics(y_test, pred)["r2"]
  )
  save_obs_pred_plot(y_test, pred,
    paste0("KNN_",       response), out_dir_figs)

  # ── Compile and save performance table ───────────────────────────────────────
  metrics_tbl <- dplyr::bind_rows(metrics_out) %>%
    dplyr::mutate(
      response = response,
      n_train  = nrow(train),
      n_test   = nrow(test)
    ) %>%
    dplyr::arrange(rmse)

  readr::write_csv(
    metrics_tbl,
    file.path(out_dir_tabs, paste0("ML_metrics_", response, ".csv"))
  )

  list(metrics = metrics_tbl, xgb_model = xgb_model)
}
