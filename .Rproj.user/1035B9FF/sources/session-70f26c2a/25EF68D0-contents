approx_sup_norm_f <- function(k, region = c("cube","sphere"), n = 5000){
  region <- match.arg(region)
  if(region == "cube"){
    Z <- matrix(runif(n*k, -1, 1), ncol = k)
  } else {
    Z <- matrix(rnorm(n*k), ncol = k)
    Z <- Z / sqrt(rowSums(Z^2))
    r <- runif(n)^(1/k) * sqrt(k)
    Z <- Z * r
  }
  Z <- as.data.frame(Z)
  colnames(Z) <- paste0("x", 1:k)
  FZ <- build_X_quadratic(Z)
  max(rowSums(FZ^2))
