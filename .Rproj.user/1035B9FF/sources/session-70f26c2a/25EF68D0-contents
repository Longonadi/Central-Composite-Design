#   2) build_X_quadratic()
#   3) design .rds files in data_generated/ (design_<DesignID>.rds)
# ============================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(readr)
library(stringr)

dir.create("results_tables",  showWarnings = FALSE, recursive = TRUE)
dir.create("results_figures", showWarnings = FALSE, recursive = TRUE)

# ------------------------------------------------------------
# STEP 0: Ensure we have meta and df_all
# ------------------------------------------------------------
meta <- readr::read_csv("data_generated/design_metadata2.csv") %>%
  mutate(DesignID = stringr::str_trim(DesignID))

stopifnot(exists("df_all"))
df_all <- df_all %>% mutate(DesignID = stringr::str_trim(DesignID))

# ============================================================
# PART 1: Eigenvalue distribution summaries
#   We compute quantiles of eigenvalues of M = X'X for each design:
#      q10, q50, q90 and a "spectral spread" ratio q90/q10
#   This is a practical way to characterize distributions without saving all eigenvalues.
# ============================================================

spec_dist_list <- vector("list", nrow(meta))

for(i in seq_len(nrow(meta))){
  id <- meta$DesignID[i]

  fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
  if(!file.exists(fpath)) next

  pts <- readRDS(fpath)
  X <- build_X_quadratic(pts)
  M <- crossprod(X)

  # Skip singular cases
  if(qr(M)$rank < ncol(X)) next

  ev <- sort(eigen(M, symmetric = TRUE, only.values = TRUE)$values)

  # Numerical safety
  ev <- ev[is.finite(ev) & ev > 0]
  if(length(ev) < 5) next

  q <- quantile(ev, probs = c(0.10, 0.50, 0.90), names = FALSE)

  spec_dist_list[[i]] <- tibble::tibble(
    DesignID = id,
    eig_q10 = q[1],
    eig_q50 = q[2],
    eig_q90 = q[3],
    eig_spread_q90_q10 = q[3] / q[1],
    eig_spread_q50_q10 = q[2] / q[1]
  )
}

spec_dist <- dplyr::bind_rows(spec_dist_list)

# Join to df_all for downstream analysis
df_spec <- df_all %>%
  left_join(spec_dist, by = "DesignID") %>%
  filter(!is.na(eig_q10), is.finite(condM), is.finite(logdetM), is.finite(min_eig))

