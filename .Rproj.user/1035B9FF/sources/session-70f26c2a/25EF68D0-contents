# ============================================================
# PART D: GEOMETRY + REGULARISED SPECTRAL FEATURES (consistent with lambda)
# ============================================================

meta <- readr::read_csv("data_generated/design_metadata_reg.csv")
geom_list <- vector("list", nrow(meta))

for(i in seq_len(nrow(meta))){
  id <- meta$DesignID[i]
  pts <- readRDS(file.path("data_generated", paste0("design_", id, ".rds")))

  X <- build_X_quadratic(pts)
  p <- ncol(X)
  M <- crossprod(X)
  Mlam <- M + diag(LAMBDA_MAIN, p)

  ev <- eigen(Mlam, symmetric=TRUE, only.values=TRUE)$values
  condM <- max(ev) / min(ev)
  logdetM <- sum(log(ev))
  min_eig <- min(ev)

  D <- as.matrix(dist(pts))
  D[D == 0] <- NA
  min_dist <- min(D, na.rm=TRUE)
  nn <- apply(D, 1, min, na.rm=TRUE)
  mean_nn <- mean(nn, na.rm=TRUE)

  geom_list[[i]] <- tibble::tibble(
    DesignID = id,
    lambda = LAMBDA_MAIN,
    condM = condM,
    min_eig = min_eig,
    logdetM = logdetM,
    min_dist = min_dist,
    mean_nn = mean_nn
  )
}

