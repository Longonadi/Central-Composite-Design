  mutate(DesignID = stringr::str_trim(DesignID))

stopifnot(exists("df_all"))
df_all <- df_all %>% mutate(DesignID = stringr::str_trim(DesignID))

# ============================================================
# PART 1: REGULARISED eigenvalue distribution summaries
#   Quantiles of eigenvalues of M_lambda
# ============================================================

spec_dist_list <- vector("list", nrow(meta))

for(i in seq_len(nrow(meta))){
  id <- meta$DesignID[i]

  fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
  if(!file.exists(fpath)) next

  pts <- readRDS(fpath)

  X <- build_X_quadratic(pts)
  p <- ncol(X)

  # Regularised information matrix
  Mlam <- crossprod(X) + lambda * diag(p)

  # Eigenvalues (always positive for lambda>0, but keep numerical safety)
  ev <- sort(eigen(Mlam, symmetric = TRUE, only.values = TRUE)$values)
  ev <- ev[is.finite(ev) & ev > 0]
  if(length(ev) < 5) next

  # Quantiles + spread proxies
  q <- quantile(ev, probs = c(0.10, 0.50, 0.90), names = FALSE)

  # Spectral features (regularised)
  min_eig_lam <- min(ev)
  condM_lam   <- max(ev) / min(ev)
  logdet_lam  <- sum(log(ev))  # log det(M_lambda)

  spec_dist_list[[i]] <- tibble::tibble(
    DesignID = id,
    lambda = lambda,

    eig_q10_lam = q[1],
    eig_q50_lam = q[2],
    eig_q90_lam = q[3],

    eig_spread_q90_q10_lam = q[3] / q[1],
    eig_spread_q50_q10_lam = q[2] / q[1],

    min_eig_lam = min_eig_lam,
    condM_lam   = condM_lam,
    logdetM_lam = logdet_lam
  )
}

spec_dist <- dplyr::bind_rows(spec_dist_list)

# Join to df_all for downstream analysis
# NOTE: df_all already contains efficiencies; we add regularised spectral features here.
