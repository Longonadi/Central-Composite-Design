# ============================================================
# OBJECTIVE 3 (REGULARISED): CROSS-DIMENSIONAL STABILITY (CDS)
# ------------------------------------------------------------
# Uses REGULARISED efficiencies computed from:
#   M_λ = X'X + λ I
#
# What it produces:
#  (1) Mean efficiencies by (k, family) for D/A/G and cube/sphere
#  (2) CDS indices per family (variance, sd, range, end-to-end change)
#  (3) Scaling-law (decay/growth) exponents beta1 from:
#        log(meanEff) = beta0 + beta1 log(k)
#  (4) PhD-friendly plots + CSV tables
#
# Assumption:
#  You already created df_all for the REGULARISED run
#  with columns (at least):
#    k, family,
#    D_eff_cube, A_eff_cube, G_eff_cube,
#    D_eff_sphere, A_eff_sphere, G_eff_sphere
#
# If your columns have suffix "_lam" or "regularised", update eff_cols below.
# ============================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(readr)

dir.create("results_tables",  showWarnings = FALSE, recursive = TRUE)
dir.create("results_figures", showWarnings = FALSE, recursive = TRUE)

# ----------------------------
# 0) Safety checks
# ----------------------------
stopifnot(exists("df_all"))
stopifnot(all(c("k","family") %in% names(df_all)))

# --- IMPORTANT: edit here if your columns are named differently ---
eff_cols <- c(
  "D_eff_cube","A_eff_cube","G_eff_cube",
  "D_eff_sphere","A_eff_sphere","G_eff_sphere"
)

miss <- setdiff(eff_cols, names(df_all))
if(length(miss) > 0){
  stop("Missing efficiency columns in df_all: ", paste(miss, collapse = ", "),
       "\nFix: either rename columns or update eff_cols in this script.")
}

df_obj3 <- df_all %>%
  mutate(
    k = as.integer(k),
    family = as.factor(family)
  )

# ----------------------------
# 1) Long format: metric + region
# ----------------------------
eff_long <- df_obj3 %>%
  select(k, family, all_of(eff_cols)) %>%
  pivot_longer(
    cols = all_of(eff_cols),
    names_to = "metric_region",
    values_to = "eff"
  ) %>%
  mutate(
    metric = sub("_eff_.*$", "", metric_region),      # D, A, G
    region = sub("^.*_eff_", "", metric_region),      # cube, sphere
    metric = factor(metric, levels = c("D","A","G")),
    region = factor(region, levels = c("cube","sphere"))
  )

# ----------------------------
# 2) Mean efficiencies by k and family (the CDS curves)
# ----------------------------
tab_mean <- eff_long %>%
  group_by(k, family, metric, region) %>%
  summarise(
    meanEff = mean(eff, na.rm = TRUE),
    sdEff   = sd(eff, na.rm = TRUE),
    n       = sum(!is.na(eff)),
    .groups = "drop"
  ) %>%
  arrange(metric, region, family, k)

write_csv(tab_mean, "results_tables/objective3_regularised_mean_eff_by_k_family.csv")

# ----------------------------
# 3) CDS indices (family-level stability scores)
#   - CDS_var  : variance of meanEff across k (lower = more stable)
#   - CDS_sd   : sd of meanEff across k
#   - CDS_range: max-min across k
#   - CDS_drop : meanEff(kmax) - meanEff(kmin) (negative = decay, positive = growth)
# ----------------------------
cds_summary <- tab_mean %>%
  group_by(family, metric, region) %>%
  summarise(
    k_min = min(k),
    k_max = max(k),
    CDS_var   = var(meanEff, na.rm = TRUE),
    CDS_sd    = sd(meanEff,  na.rm = TRUE),
    CDS_range = max(meanEff, na.rm = TRUE) - min(meanEff, na.rm = TRUE),
    CDS_drop  = meanEff[k == max(k)][1] - meanEff[k == min(k)][1],
    mean_over_k = mean(meanEff, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  arrange(metric, region, CDS_var)

write_csv(cds_summary, "results_tables/objective3_regularised_CDS_summary_by_family.csv")

# ----------------------------
# 4) Scaling-law exponents (decay/growth with k)
#   log(meanEff) = beta0 + beta1 log(k)
#   Interpretation:
#     beta1 ~ 0     => stable (scale-invariant)
#     beta1 < 0     => degenerating with dimension
#     beta1 > 0     => improving with dimension (under regularisation)
# ----------------------------
scaling_fits <- tab_mean %>%
  filter(is.finite(meanEff), meanEff > 0, k > 0) %>%
  mutate(logMeanEff = log(meanEff), logk = log(k)) %>%
  group_by(family, metric, region) %>%
  do({
    fit <- lm(logMeanEff ~ logk, data = .)
    sm <- summary(fit)
    data.frame(
      beta0   = unname(coef(fit)[1]),
      beta1   = unname(coef(fit)[2]),
      r2      = sm$r.squared,
      adj_r2  = sm$adj.r.squared,
      p_beta1 = sm$coefficients["logk","Pr(>|t|)"]
    )
  }) %>%
  ungroup() %>%
  mutate(
    significant = ifelse(p_beta1 < 0.05, "Yes", "No"),
    stability_class = case_when(
      p_beta1 >= 0.05 ~ "stable (beta1 not significant)",
      p_beta1 < 0.05 & beta1 < 0 ~ "degenerating (significant decay)",
      p_beta1 < 0.05 & beta1 > 0 ~ "improving (significant growth)",
      TRUE ~ "undetermined"
    )
  ) %>%
  arrange(metric, region, abs(beta1))

write_csv(scaling_fits, "results_tables/objective3_regularised_scaling_exponents.csv")

# ----------------------------
# 5) Plots (PhD-friendly)
#   (A) Mean efficiency curves vs k (facet by metric x region)
# ----------------------------
p_mean_curves <- ggplot(tab_mean,
                        aes(x = k, y = meanEff,
                            color = family, linetype = family, shape = family,
                            group = family)) +
  geom_line(linewidth = 1.05) +
  geom_point(size = 2.6) +
  facet_grid(metric ~ region, scales = "free_y") +
  labs(
    x = "Number of factors (k)",
    y = "Mean efficiency",
    color = "CCD family", linetype = "CCD family", shape = "CCD family",
    title = "Objective 3 (Regularised): Cross-dimensional mean efficiency curves"
  ) +
  theme_minimal(base_size = 14) +
  theme(legend.position = "right")

ggsave("results_figures/objective3_regularised_mean_eff_vs_k_faceted.png",
       p_mean_curves, width = 11, height = 7)

#   (B) Scaling exponent beta1 plot
p_beta1 <- ggplot(scaling_fits, aes(x = family, y = beta1, fill = family)) +
  geom_col() +
  facet_grid(metric ~ region, scales = "free_y") +
  labs(
    x = "CCD family",
    y = expression(hat(beta)[1]~"in"~log(meanEff)~"="~beta[0]+beta[1] *log(k)),
    title = "Objective 3 (Regularised): Scaling/decay exponents (beta1)"
  ) +
  theme_minimal(base_size = 14) +
  theme(legend.position = "none")

ggsave("results_figures/objective3_regularised_scaling_exponents_beta1.png",
       p_beta1, width = 11, height = 7)

#   (C) CDS variance heatmap (lower = more stable)
p_cds_heat <- cds_summary %>%
  mutate(metric_region = paste(metric, region, sep = "_")) %>%
  ggplot(aes(x = metric_region, y = family, fill = CDS_var)) +
  geom_tile() +
  labs(
    x = "Criterion_Region",
    y = "CCD family",
    title = "Objective 3 (Regularised): CDS variance heatmap (lower = more stable)"
  ) +
  theme_minimal(base_size = 14)

ggsave("results_figures/objective3_regularised_CDS_variance_heatmap.png",
       p_cds_heat, width = 9, height = 4.8)

# ----------------------------
# 6) Print key outputs (for knitting)
# ----------------------------
tab_mean
cds_summary
scaling_fits
p_mean_curves
p_beta1
p_cds_heat
