# ============================================================
# OBJECTIVE 2 (REGULARISED): SPECTRAL CHARACTERIZATION OF CCD INFORMATION MATRICES
#   - Eigenvalue distribution (quantiles + spread measures)
#   - Growth of condition number and determinant with dimension k
#   - Link spectral measures to D-, A-, G-efficiencies (cube + sphere)
#
# Regularisation: M_lambda = X'X + lambda I
# ============================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(readr)
library(stringr)
library(tibble)

dir.create("results_tables",  showWarnings = FALSE, recursive = TRUE)
dir.create("results_figures", showWarnings = FALSE, recursive = TRUE)

# ----------------------------
# USER SETTING: regularisation strength
# ----------------------------
