# --- 2A: Compute spectral features for every design ---
spec_list <- vector("list", nrow(meta))

for (i in seq_len(nrow(meta))) {
  id    <- meta$DesignID[i]
  fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
  if (!file.exists(fpath)) next
  pts  <- readRDS(fpath)
  X    <- build_X_quadratic(pts)
  p    <- ncol(X)
  Mlam <- crossprod(X) + best_lambda * diag(p)
  ev   <- sort(eigen(Mlam, symmetric = TRUE, only.values = TRUE)$values)
  ev   <- ev[is.finite(ev) & ev > 0]
  if (length(ev) < 5) next
  q    <- quantile(ev, probs = c(0.1, 0.5, 0.9), names = FALSE)
  spec_list[[i]] <- tibble::tibble(
    DesignID       = id,
    eig_q10        = q[1],
    eig_q50        = q[2],
    eig_q90        = q[3],
    eig_spread     = q[3] / q[1],
    min_eig        = min(ev),
    max_eig        = max(ev),
    condM          = max(ev) / min(ev),
    logdetM        = sum(log(ev))
  )
}

spec_data <- dplyr::bind_rows(spec_list)

# Merge spectral features with efficiency data
df_spec <- df_all %>%
  dplyr::left_join(spec_data, by = "DesignID") %>%
  dplyr::filter(!is.na(condM)) %>%
