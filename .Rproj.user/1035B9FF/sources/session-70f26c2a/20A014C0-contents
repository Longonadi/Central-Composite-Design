wf_rf_cls   <- workflows::workflow() %>%
  workflows::add_recipe(rec_cls) %>% workflows::add_model(rf_cls_spec)
wf_xgb_cls  <- workflows::workflow() %>%
  workflows::add_recipe(rec_cls) %>% workflows::add_model(xgb_cls_spec)
wf_svm_cls  <- workflows::workflow() %>%
  workflows::add_recipe(rec_cls) %>% workflows::add_model(svm_cls_spec)
wf_mlog_cls <- workflows::workflow() %>%
  workflows::add_recipe(rec_cls) %>% workflows::add_model(mlog_cls_spec)

# Tuning grids
rf_cls_grid <- dials::grid_regular(
  dials::mtry(range = c(2, max(2, length(Xvars_cls)))),
  dials::min_n(range = c(2, 20)),
  levels = 5
)

xgb_cls_grid <- dials::grid_latin_hypercube(
  dials::trees(range = c(200L, 1000L)),
  dials::tree_depth(range = c(2L, 7L)),
  dials::learn_rate(range = c(0.01, 0.25)),
  dials::mtry(range = c(2L, max(2L, length(Xvars_cls)))),
  dials::min_n(range = c(2L, 25L)),
  dials::loss_reduction(),
  dials::sample_size = dials::sample_prop(),
  size = 20
)

svm_cls_grid <- dials::grid_regular(
  dials::cost(range = c(-3, 3)),
  dials::rbf_sigma(range = c(-5, 0)),
  levels = 6
)

# CV tuning
rf_res_cls   <- tune::tune_grid(wf_rf_cls,  folds_cls, rf_cls_grid,  cls_metrics)
xgb_res_cls  <- tune::tune_grid(wf_xgb_cls, folds_cls, xgb_cls_grid, cls_metrics)
svm_res_cls  <- tune::tune_grid(wf_svm_cls, folds_cls, svm_cls_grid, cls_metrics)
mlog_res_cls <- tune::fit_resamples(wf_mlog_cls, folds_cls, metrics = cls_metrics)

# Finalise and fit on full training set
final_rf_cls   <- tune::finalize_workflow(wf_rf_cls,  tune::select_best(rf_res_cls,  "accuracy")) %>%
  parsnip::fit(train_cls)
final_xgb_cls  <- tune::finalize_workflow(wf_xgb_cls, tune::select_best(xgb_res_cls, "accuracy")) %>%
  parsnip::fit(train_cls)
final_svm_cls  <- tune::finalize_workflow(wf_svm_cls, tune::select_best(svm_res_cls, "accuracy")) %>%
  parsnip::fit(train_cls)
final_mlog_cls <- parsnip::fit(wf_mlog_cls, data = train_cls)

# CV accuracy summary
cv_accuracy <- dplyr::bind_rows(
  tune::collect_metrics(rf_res_cls)   %>% dplyr::filter(.metric == "accuracy") %>%
    dplyr::summarise(model = "Random Forest",         mean_accuracy = mean(mean), .groups = "drop"),
  tune::collect_metrics(xgb_res_cls)  %>% dplyr::filter(.metric == "accuracy") %>%
    dplyr::summarise(model = "XGBoost",               mean_accuracy = mean(mean), .groups = "drop"),
  tune::collect_metrics(svm_res_cls)  %>% dplyr::filter(.metric == "accuracy") %>%
    dplyr::summarise(model = "SVM-RBF",               mean_accuracy = mean(mean), .groups = "drop"),
  tune::collect_metrics(mlog_res_cls) %>% dplyr::filter(.metric == "accuracy") %>%
    dplyr::summarise(model = "Multinomial Logistic",  mean_accuracy = mean(mean), .groups = "drop")
) %>% dplyr::arrange(desc(mean_accuracy))

readr::write_csv(cv_accuracy, "results_tables4/obj5_CV_accuracy_classification.csv")
cat("\nCV Accuracy Summary:\n")
print(cv_accuracy)

# Test set evaluation
eval_cls <- function(fitted_wf, test_df, model_name) {
  preds <- predict(fitted_wf, test_df, type = "class") %>%
    dplyr::bind_cols(test_df %>% dplyr::select(family))
  list(
    model = model_name,
    acc   = yardstick::accuracy(preds, truth = family, estimate = .pred_class),
    cm    = yardstick::conf_mat(preds, truth = family, estimate = .pred_class)
  )
}

res_rf_cls   <- eval_cls(final_rf_cls,   test_cls, "Random Forest")
res_xgb_cls  <- eval_cls(final_xgb_cls,  test_cls, "XGBoost")
res_svm_cls  <- eval_cls(final_svm_cls,  test_cls, "SVM-RBF")
res_mlog_cls <- eval_cls(final_mlog_cls, test_cls, "Multinomial Logistic")

# Print results
cat("\nTest Set Results:\n")
for (r in list(res_rf_cls, res_xgb_cls, res_svm_cls, res_mlog_cls)) {
  cat(r$model, "- Accuracy:", round(r$acc$.estimate, 4), "\n")
  print(r$cm)
}

