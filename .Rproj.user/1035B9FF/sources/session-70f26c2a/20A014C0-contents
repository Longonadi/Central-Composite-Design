#   Band 1: k = 3, 4, 5  (low dimensions)
#   Band 2: k = 6, 7, 8  (medium dimensions)
#   Band 3: k = 9, 10    (high dimensions)
# ============================================================

cat("\n--- GAP FIX: ML effectiveness across dimensional bands ---\n")

run_dimensional_effectiveness <- function(response_var, df, Xvars,
                                          response_label, outdir_tab, outdir_fig) {

  model_df <- df %>%
    dplyr::filter(complete.cases(dplyr::across(dplyr::all_of(c(Xvars, response_var))))) %>%
    dplyr::mutate(dim_band = dplyr::case_when(
      k %in% 3:5   ~ "Low (k=3-5)",
      k %in% 6:8   ~ "Medium (k=6-8)",
      k %in% 9:10  ~ "High (k=9-10)",
      TRUE ~ NA_character_
    ))

  # Train on ALL data (80/20 global split)
  set.seed(6)
  idx   <- sample(seq_len(nrow(model_df)), floor(0.8 * nrow(model_df)))
  train <- model_df[idx, ]
  test  <- model_df[-idx, ]

  # Fit best two models (RF and XGBoost) once on full training set
  rf_fit <- ranger::ranger(
    as.formula(paste(response_var, "~ .")),
    data      = train[, c(response_var, Xvars)],
    num.trees = 800
  )

  dtrain <- xgboost::xgb.DMatrix(
    data  = as.matrix(train[, Xvars]),
    label = train[[response_var]]
  )
  xgb_fit_dim <- xgboost::xgb.train(
    list(objective = "reg:squarederror", max_depth = 5,
         eta = 0.06, subsample = 0.8, colsample_bytree = 0.8),
    dtrain, nrounds = 600, verbose = 0
  )

  # Evaluate within each dimensional band on the TEST set
  band_results <- list()

  for (band in c("Low (k=3-5)", "Medium (k=6-8)", "High (k=9-10)")) {
    test_band <- test %>% dplyr::filter(dim_band == band)
    if (nrow(test_band) < 5) next

    x_band <- as.matrix(test_band[, Xvars])
    y_band <- test_band[[response_var]]

    pred_rf  <- predict(rf_fit, data = test_band[, Xvars])$predictions
    pred_xgb <- predict(xgb_fit_dim, xgboost::xgb.DMatrix(data = x_band))

    m_rf  <- reg_metrics(y_band, pred_rf)
    m_xgb <- reg_metrics(y_band, pred_xgb)

    band_results[[band]] <- tibble::tibble(
      Response    = response_label,
      Band        = band,
      k_range     = band,
      n_test_band = nrow(test_band),
      RF_RMSE     = m_rf["RMSE"],
      RF_R2       = m_rf["R2"],
      XGB_RMSE    = m_xgb["RMSE"],
      XGB_R2      = m_xgb["R2"]
    )
  }

  dplyr::bind_rows(band_results)
}

