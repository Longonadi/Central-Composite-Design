# --- Run ML pipeline for one response variable ---
run_ml_pipeline <- function(response_var, df, Xvars, outdir_fig, outdir_tab, response_label) {

  cat("\n-- Response:", response_label, "--\n")

  model_df <- df %>%
    dplyr::filter(complete.cases(dplyr::across(dplyr::all_of(c(Xvars, response_var)))))

  cat("Rows available:", nrow(model_df), "\n")

  # 80/20 split
  idx     <- sample(seq_len(nrow(model_df)), floor(0.8 * nrow(model_df)))
  train   <- model_df[idx, ]
  test    <- model_df[-idx, ]

  x_train <- as.matrix(train[, Xvars])
  x_test  <- as.matrix(test[, Xvars])
  y_train <- train[[response_var]]
  y_test  <- test[[response_var]]

  # Scaled versions (SVR, KNN, NNET)
  sc        <- scale(x_train)
  x_sc_tr   <- sc
  x_sc_te   <- scale(x_test,
                     center = attr(sc, "scaled:center"),
                     scale  = attr(sc, "scaled:scale"))
  train_sc  <- as.data.frame(x_sc_tr); train_sc[[response_var]] <- y_train
  test_sc   <- as.data.frame(x_sc_te)

  metrics_out <- list()

  # ---- MODEL 1: Linear Regression ----
  fit1   <- lm(as.formula(paste(response_var, "~ .")),
               data = train[, c(response_var, Xvars)])
  pred1  <- predict(fit1, newdata = test)
  m1     <- reg_metrics(y_test, pred1)
  metrics_out[["LinearRegression"]] <- data.frame(
    Model = "Linear Regression", RMSE = m1["RMSE"], R2 = m1["R2"])
  save_obs_pred(y_test, pred1, paste("LinearReg", response_label), outdir_fig)

  # ---- MODEL 2: Random Forest ----
  rf_f   <- as.formula(paste(response_var, "~ ."))
  fit2   <- ranger::ranger(rf_f, data = train[, c(response_var, Xvars)],
                           num.trees = 800, importance = "permutation")
  pred2  <- predict(fit2, data = test[, Xvars])$predictions
  m2     <- reg_metrics(y_test, pred2)
  metrics_out[["RandomForest"]] <- data.frame(
    Model = "Random Forest", RMSE = m2["RMSE"], R2 = m2["R2"])
  save_obs_pred(y_test, pred2, paste("RandomForest", response_label), outdir_fig)

  # Variable importance (RF)
  p_imp <- vip::vip(fit2, num_features = 12) +
    ggtitle(paste("RF Variable Importance:", response_label))
  ggsave(file.path(outdir_fig, paste0("importance_RF_", response_var, ".png")),
         p_imp, width = 8, height = 5)

  # ---- MODEL 3: XGBoost ----
  dtrain <- xgboost::xgb.DMatrix(data = x_train, label = y_train)
  dtest  <- xgboost::xgb.DMatrix(data = x_test,  label = y_test)
  xgb_params <- list(objective = "reg:squarederror", eval_metric = "rmse",
                     max_depth = 5, eta = 0.06, subsample = 0.8,
                     colsample_bytree = 0.8)
  fit3  <- xgboost::xgb.train(xgb_params, dtrain, nrounds = 600, verbose = 0)
  pred3 <- predict(fit3, dtest)
  m3    <- reg_metrics(y_test, pred3)
  metrics_out[["XGBoost"]] <- data.frame(
    Model = "XGBoost", RMSE = m3["RMSE"], R2 = m3["R2"])
  save_obs_pred(y_test, pred3, paste("XGBoost", response_label), outdir_fig)

  # XGBoost importance
  imp_xgb <- xgboost::xgb.importance(model = fit3)
  p_xgb_imp <- ggplot(head(imp_xgb, 12), aes(reorder(Feature, Gain), Gain)) +
    geom_col() + coord_flip() +
    labs(x = "Feature", y = "Gain",
         title = paste("XGBoost Importance:", response_label)) +
    theme_minimal(base_size = 13)
  ggsave(file.path(outdir_fig, paste0("importance_XGB_", response_var, ".png")),
         p_xgb_imp, width = 8, height = 5)

  # Store XGBoost model for combined importance plot (returned later)
  assign(paste0("xgb_fit_", response_var), fit3, envir = .GlobalEnv)

  # ---- MODEL 4: SVR (RBF kernel) ----
  fit4  <- e1071::svm(x = x_sc_tr, y = y_train,
                      type = "eps-regression", kernel = "radial")
  pred4 <- predict(fit4, x_sc_te)
  m4    <- reg_metrics(y_test, pred4)
  metrics_out[["SVR"]] <- data.frame(
    Model = "SVR (RBF)", RMSE = m4["RMSE"], R2 = m4["R2"])
  save_obs_pred(y_test, pred4, paste("SVR", response_label), outdir_fig)

  # ---- MODEL 5: KNN Regression ----
  fit5  <- FNN::knn.reg(train = x_sc_tr, test = x_sc_te, y = y_train, k = 10)
  pred5 <- fit5$pred
  m5    <- reg_metrics(y_test, pred5)
  metrics_out[["KNN"]] <- data.frame(
    Model = "KNN (k=10)", RMSE = m5["RMSE"], R2 = m5["R2"])
  save_obs_pred(y_test, pred5, paste("KNN", response_label), outdir_fig)

  # ---- MODEL 6: Gradient Boosting Machine (GBM) ----
  fit6  <- gbm::gbm(as.formula(paste(response_var, "~ .")),
                    data = train[, c(response_var, Xvars)],
                    distribution = "gaussian",
                    n.trees = 500, interaction.depth = 4,
                    shrinkage = 0.05, bag.fraction = 0.75,
                    verbose = FALSE)
  pred6 <- predict(fit6, newdata = test, n.trees = 500)
  m6    <- reg_metrics(y_test, pred6)
  metrics_out[["GBM"]] <- data.frame(
    Model = "GBM", RMSE = m6["RMSE"], R2 = m6["R2"])
  save_obs_pred(y_test, pred6, paste("GBM", response_label), outdir_fig)

  # ---- MODEL 7: Neural Network (single hidden layer) ----
  fit7  <- nnet::nnet(as.formula(paste(response_var, "~ .")),
                      data = train_sc, linout = TRUE,
                      size = 8, decay = 1e-4, maxit = 500, trace = FALSE)
  pred7 <- as.numeric(predict(fit7, newdata = test_sc))
  m7    <- reg_metrics(y_test, pred7)
  metrics_out[["NeuralNet"]] <- data.frame(
    Model = "Neural Network", RMSE = m7["RMSE"], R2 = m7["R2"])
  save_obs_pred(y_test, pred7, paste("NeuralNet", response_label), outdir_fig)

  # ---- MODEL 8: MARS (Multivariate Adaptive Regression Splines) ----
  fit8  <- earth::earth(as.formula(paste(response_var, "~ .")),
                        data = train[, c(response_var, Xvars)],
                        degree = 2)
  pred8 <- as.numeric(predict(fit8, newdata = test))
  m8    <- reg_metrics(y_test, pred8)
  metrics_out[["MARS"]] <- data.frame(
    Model = "MARS", RMSE = m8["RMSE"], R2 = m8["R2"])
  save_obs_pred(y_test, pred8, paste("MARS", response_label), outdir_fig)

  # --- Compile metrics table ---
  metrics_tbl <- dplyr::bind_rows(metrics_out) %>%
    dplyr::mutate(Response = response_label,
                  n_train  = nrow(train),
                  n_test   = nrow(test)) %>%
    dplyr::arrange(RMSE)

  fname <- file.path(outdir_tab,
                     paste0("obj4_ML_metrics_", response_var, ".csv"))
  readr::write_csv(metrics_tbl, fname)

  cat("Results for", response_label, ":\n")
  print(metrics_tbl[, c("Model", "RMSE", "R2")])

  # Return key objects for gap analysis
  list(
    metrics  = metrics_tbl,
    train_df = train,
    test_df  = test,
    best_rf  = fit2,
    best_xgb = fit3
  )
}

