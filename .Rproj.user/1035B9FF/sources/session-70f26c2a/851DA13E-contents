```{r setup, include=FALSE}
############################################################
# OBJECTIVE 1
# Evaluate CCD families (FCCD, RCCD, SCCD)
# using D-, A-, and G-efficiency
#
# Categories:
#   1. Classical CCD (k = 3–6)
#   2. Regularised CCD (k = 3–10)
#   3. Scaled regularised CCD (k = 3–10)
############################################################

library(dplyr)
library(ggplot2)
library(FrF2)

set.seed(6)
############################################################
# CCD generator
############################################################

make_ccd <- function(k, family, nc, rf, ra){

family <- as.character(family)

alpha <- switch(family,
                "FCCD" = 1,
                "RCCD" = (2^k)^(1/4),
                "SCCD" = sqrt(k))

if(k <= 6){
fac <- as.data.frame(FrF2(nruns = 2^k, nfactors = k))
}else{
fac <- as.data.frame(FrF2(nruns = 32, nfactors = k))
}

fac <- fac[,1:k]
colnames(fac) <- paste0("x",1:k)

fac <- mutate_all(fac, ~ifelse(.==1,1,-1))
fac_rep <- fac[rep(1:nrow(fac),rf),]

ax <- matrix(0,2*k,k)

for(j in 1:k){
ax[2*j-1,j] <- alpha
ax[2*j,j] <- -alpha
}

ax <- as.data.frame(ax)
colnames(ax) <- paste0("x",1:k)

ax_rep <- ax[rep(1:nrow(ax),ra),]

cen <- as.data.frame(matrix(0,nc,k))
colnames(cen) <- paste0("x",1:k)

design <- bind_rows(fac_rep,ax_rep,cen)

design
}
############################################################
# Quadratic regression model matrix
############################################################

build_X <- function(df){

vars <- names(df)

form <- as.formula(
paste0("~",
paste(vars,collapse="+"),
"+",
paste0("I(",vars,"^2)",collapse="+"),
"+(",
paste(vars,collapse="+"),
")^2")
)

model.matrix(form,data=df)

}
############################################################
# Classical criteria
############################################################

compute_classical <- function(X){

p <- ncol(X)

M <- crossprod(X)

if(qr(M)$rank < p) return(NULL)

Minv <- solve(M)

D <- det(M)^(1/p)

A <- sum(diag(Minv))

G <- max(diag(X %*% Minv %*% t(X)))

c(D,A,G)

}
############################################################
# Regularised criteria
############################################################

compute_regularised <- function(X, lambda = 0.01){

p <- ncol(X)

M <- crossprod(X) + lambda*diag(p)

Minv <- solve(M)

D <- det(M)^(1/p)

A <- sum(diag(Minv))

G <- max(diag(X %*% Minv %*% t(X)))

c(D,A,G)

}
############################################################
# Scaled regularised criteria
############################################################

compute_scaled <- function(X, lambda = 0.01){

p <- ncol(X)

M <- crossprod(X) + lambda*diag(p)

scale_factor <- mean(diag(M))

Mscaled <- M/scale_factor

Minv <- solve(Mscaled)

D <- det(Mscaled)^(1/p)

A <- sum(diag(Minv))

G <- max(diag(X %*% Minv %*% t(X)))

c(D,A,G)

}
############################################################
# Simulation grid
############################################################

k_grid <- 3:10
families <- c("FCCD","RCCD","SCCD")

nc_grid <- c(1,3,5,7,10)
rf_grid <- c(1,2,3)
ra_grid <- c(1,2,3)

grid <- expand.grid(
k = k_grid,
family = families,
nc = nc_grid,
rf = rf_grid,
ra = ra_grid,
stringsAsFactors = FALSE
)
############################################################
# Run simulation
############################################################

results <- list()

for(i in 1:nrow(grid)){

row <- grid[i,]

design <- make_ccd(row$k,row$family,row$nc,row$rf,row$ra)

X <- build_X(design)

classical <- if(row$k <= 6) compute_classical(X) else c(NA,NA,NA)

regularised <- compute_regularised(X)

scaled <- compute_scaled(X)

results[[i]] <- data.frame(

k = row$k,
family = row$family,

D_classical = classical[1],
A_classical = classical[2],
G_classical = classical[3],

D_reg = regularised[1],
A_reg = regularised[2],
G_reg = regularised[3],

D_scaled = scaled[1],
A_scaled = scaled[2],
G_scaled = scaled[3]

)

}

results_df <- bind_rows(results)
############################################################
# Mean efficiency by CCD family and dimension
############################################################

mean_eff <- results_df %>%
group_by(k,family) %>%
summarise(

meanD_classical = mean(D_classical,na.rm=TRUE),
meanA_classical = mean(A_classical,na.rm=TRUE),
meanG_classical = mean(G_classical,na.rm=TRUE),

meanD_reg = mean(D_reg,na.rm=TRUE),
meanA_reg = mean(A_reg,na.rm=TRUE),
meanG_reg = mean(G_reg,na.rm=TRUE),

meanD_scaled = mean(D_scaled,na.rm=TRUE),
meanA_scaled = mean(A_scaled,na.rm=TRUE),
meanG_scaled = mean(G_scaled,na.rm=TRUE)

)
```

