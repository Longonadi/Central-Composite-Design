# ---- What this does ----
# Computes structural descriptors used as ML predictors:
# - condition number, min eigenvalue, log determinant of M
# - min distance and mean nearest-neighbor distance among design points
# -------------------------

meta <- readr::read_csv("data_generated/design_metadata.csv")

geom_list <- vector("list", nrow(meta))

for(i in seq_len(nrow(meta))){
  id <- meta$DesignID[i]
  pts <- readRDS(file.path("data_generated", paste0("design_", id, ".rds")))

  X <- build_X_quadratic(pts)
  M <- crossprod(X)
  if(qr(M)$rank < ncol(X)) next

  ev <- eigen(M, symmetric=TRUE, only.values=TRUE)$values
  condM <- max(ev) / min(ev)
  logdetM <- sum(log(ev))

  D <- as.matrix(dist(pts))
  D[D == 0] <- NA
  min_dist <- min(D, na.rm=TRUE)
  nn <- apply(D, 1, min, na.rm=TRUE)
  mean_nn <- mean(nn, na.rm=TRUE)

  geom_list[[i]] <- tibble::tibble(
    DesignID = id,
    condM = condM,
    min_eig = min(ev),
    logdetM = logdetM,
    min_dist = min_dist,
    mean_nn = mean_nn
  )
}

geometry_features <- dplyr::bind_rows(geom_list)
readr::write_csv(geometry_features, "data_generated/geometry_features2.csv")
