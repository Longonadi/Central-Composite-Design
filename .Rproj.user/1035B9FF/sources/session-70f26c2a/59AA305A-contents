# ---- What this does ----
# Trains ML models to learn: geometry/features -> efficiency
# Here we show G-eff (cube) as example. Repeat for A_eff and D_eff similarly.
# -------------------------

Xvars <- c("k","nc","rf","ra","alpha","N","Nf","Na","Nc",
           "condM","min_eig","logdetM","min_dist","mean_nn")

model_df <- df_all %>% dplyr::filter(complete.cases(across(all_of(c(Xvars,"G_eff_cube")))))
set.seed(2026)
idx <- sample(seq_len(nrow(model_df)), floor(0.8*nrow(model_df)))
train <- model_df[idx, ]
test  <- model_df[-idx, ]

rf <- ranger::ranger(
  G_eff_cube ~ ., data = train[, c("G_eff_cube", Xvars)],
  num.trees = 800, importance = "permutation"
)

pred_rf <- predict(rf, data = test[, Xvars])$predictions
rmse_rf <- sqrt(mean((pred_rf - test$G_eff_cube)^2))
r2_rf <- 1 - sum((pred_rf - test$G_eff_cube)^2) / sum((test$G_eff_cube - mean(test$G_eff_cube))^2)

rmse_rf; r2_rf
```

