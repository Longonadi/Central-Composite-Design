# Checks if Gcrit changes substantially when g_n increases
ids <- meta$DesignID[1:50]

rob <- purrr::map_dfr(ids, function(id){
  pts <- readRDS(file.path("data_generated", paste0("design_", id, ".rds")))
  c1 <- compute_ADG(pts, "cube", g_n = 2000)
  c2 <- compute_ADG(pts, "cube", g_n = 10000)
  if(is.null(c1) || is.null(c2)) return(NULL)
  tibble::tibble(
    DesignID = id,
    Gcrit_2k = c1$Gcrit,
    Gcrit_10k = c2$Gcrit,
    rel_diff = abs(c2$Gcrit - c1$Gcrit) / c2$Gcrit
  )
})

readr::write_csv(rob, "results_tables/robustness_G_sampling2.csv")
summary(rob$rel_diff)
