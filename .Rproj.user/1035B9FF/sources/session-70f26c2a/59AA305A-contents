library(dplyr)
library(ggplot2)
# ---- What this does ----
# Converts criteria to efficiencies within each k:
# D_eff = D / max(D)
# A_eff = min(A) / A
# G_eff = min(G) / G
# -------------------------

df <- meta %>% dplyr::inner_join(criteria_raw, by="DesignID")

criteria_eff <- df %>%
  dplyr::group_by(k) %>%
  dplyr::mutate(
    D_eff_cube = Dcrit_cube / max(Dcrit_cube, na.rm=TRUE),
    A_eff_cube = min(Acrit_cube, na.rm=TRUE) / Acrit_cube,
    G_eff_cube = min(Gcrit_cube, na.rm=TRUE) / Gcrit_cube,

    D_eff_sphere = Dcrit_sphere / max(Dcrit_sphere, na.rm=TRUE),
    A_eff_sphere = min(Acrit_sphere, na.rm=TRUE) / Acrit_sphere,
    G_eff_sphere = min(Gcrit_sphere, na.rm=TRUE) / Gcrit_sphere
  ) %>% dplyr::ungroup()

readr::write_csv(criteria_eff, "data_generated/criteria_efficiencies2.csv")
summary(criteria_eff$G_eff_cube)
