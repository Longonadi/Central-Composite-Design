# ---- What this does ----
# Loops through every design and computes Dcrit, Acrit, Gcrit on:
# - cube region
# - sphere region
# Stores in criteria_raw.csv
# -------------------------

meta <- readr::read_csv("data_generated/design_metadata.csv")
out_list <- vector("list", nrow(meta))

for(i in seq_len(nrow(meta))){
  id <- meta$DesignID[i]
  pts <- readRDS(file.path("data_generated", paste0("design_", id, ".rds")))

  crit_cube <- compute_ADG(pts, "cube",  g_n = 5000)
  crit_sph  <- compute_ADG(pts, "sphere", g_n = 5000)

  if(is.null(crit_cube) || is.null(crit_sph)) next

  out_list[[i]] <- tibble::tibble(
    DesignID = id,
    Dcrit_cube = crit_cube$Dcrit,
    Acrit_cube = crit_cube$Acrit,
    Gcrit_cube = crit_cube$Gcrit,
    Dcrit_sphere = crit_sph$Dcrit,
    Acrit_sphere = crit_sph$Acrit,
    Gcrit_sphere = crit_sph$Gcrit
  )
}

criteria_raw <- dplyr::bind_rows(out_list)
readr::write_csv(criteria_raw, "data_generated/criteria_raw2.csv")
head(criteria_raw)
