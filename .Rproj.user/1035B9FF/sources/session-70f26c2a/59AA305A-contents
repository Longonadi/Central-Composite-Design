# ---- What this does ----
# Creates all CCD designs across the grid of (k, family, nc, rf, ra, core)
# Saves each design as an RDS file and saves metadata as CSV.
# -------------------------

k_grid  <- 3:10
families <- c("FCCD","RCCD","SCCD","OCCD")
nc_grid <- c(1,3,5,7,10)
rf_grid <- c(1,2,3)
ra_grid <- c(1,2,3)
core_grid <- c("full","frac")

grid <- expand.grid(
  k = k_grid, family = families, nc = nc_grid, rf = rf_grid, ra = ra_grid, core = core_grid,
  stringsAsFactors = FALSE
)

meta_list <- vector("list", nrow(grid))

for(i in seq_len(nrow(grid))){
  row <- grid[i, ]
  out <- make_ccd(row$k, row$family, row$nc, row$rf, row$ra, row$core)
  meta_list[[i]] <- out$meta
  saveRDS(out$points, file.path("data_generated", paste0("design_", out$meta$DesignID, ".rds")))
}

design_metadata <- dplyr::bind_rows(meta_list)
readr::write_csv(design_metadata, "data_generated/design_metadata2.csv")

head(design_metadata)
