Complexity & Simpler & Slightly more complex \\
\bottomrule
\end{tabular}
\end{table}

\subsection{When to Use Each Approach}

\textbf{Use Unscaled Regularisation when:}
\begin{itemize}
    \item Analysing only low dimensions ($k \leq 6$)
    \item Focusing primarily on D-optimality
    \item Simplicity is paramount
\end{itemize}

\textbf{Use Scaled Regularisation when:}
\begin{itemize}
    \item Comparing designs across a wide range of dimensions ($k = 3$ to $10$)
    \item A-optimality and G-optimality are important criteria
    \item Meaningful efficiency values are required at high dimensions
\end{itemize}

%=============================================================================
\section{Summary of Scaled Regularised Formulae}
%=============================================================================

\begin{table}[h]
\centering
\caption{Summary of scaled regularised optimality criteria}
\label{tab:scaledsummary}
\begin{tabular}{ll}
\toprule
Quantity & Formula \\
\midrule
Scaling factor & $\bar{\mu} = \dfrac{\tr(X'X)}{p}$ \\[10pt]
Scaled parameter & $\lambda_s = \lambda \cdot \bar{\mu}$ \\[10pt]
Regularised matrix & $M_{\lambda,s} = X'X + \lambda_s I_p$ \\[10pt]
A-criterion & $\Phi_A = \displaystyle\sum_{i=1}^{p} \frac{1}{\mu_i + \lambda_s}$ \\[14pt]
A-efficiency & $A_{\text{eff},\lambda,s} = \dfrac{100p}{N \cdot \tr(M_{\lambda,s}^{-1})}$ \\[14pt]
D-criterion & $\Phi_D = \displaystyle\prod_{i=1}^{p} (\mu_i + \lambda_s)$ \\[14pt]
D-efficiency & $D_{\text{eff},\lambda,s} = 100\left(\dfrac{|M_{\lambda,s}|}{N}\right)^{1/p}$ \\[14pt]
G-criterion & $\Phi_G = \max_{\mathbf{x}} N\mathbf{f}'M_{\lambda,s}^{-1}\mathbf{f}$ \\[10pt]
G-efficiency & $G_{\text{eff},\lambda,s} = \dfrac{100p}{N \cdot \hat{\sigma}^2_{\max,\lambda,s}}$ \\[14pt]
\bottomrule
\end{tabular}
\end{table}

Key quantities for $k = 3$ with scaled regularisation:
\begin{align}
\lambda_s &= \lambda \cdot \frac{N + 3x + 3y + 3f}{10} \\[6pt]
D_{\lambda_s} &= (y + \lambda_s - f)(y + \lambda_s + 2f) \\[6pt]
Z_{1,\lambda_s} &= (N + \lambda_s)(y + \lambda_s + 2f) - 3x^2 \\[6pt]
Z_{2,\lambda_s} &= (y + \lambda_s - f) \cdot Z_{1,\lambda_s}
\end{align}

