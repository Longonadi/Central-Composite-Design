# ----------------------------------------------------------
# make_ccd()
# Generates a Central Composite Design (factorial + axial + centre)
# with replication controls supporting FCCD, RCCD, and SCCD families.
#   k = 3 to 5  -> full 2^k factorial core
#   k = 6 to 10 -> fixed 32-run (2^5) factorial core
# ----------------------------------------------------------
make_ccd <- function(k, family, nc, rf, ra) {

  alpha <- switch(family,
    "FCCD" = 1,
    "RCCD" = (2^k)^(1/4),
    "SCCD" = sqrt(k),
    stop("Unknown family: ", family)
  )

  if (k <= 5) {
    fac <- as.data.frame(FrF2::FrF2(nruns = 2^k, nfactors = k))
  } else {
    fac <- as.data.frame(FrF2::FrF2(nruns = 32, nfactors = k))
  }

  fac <- fac[, 1:k, drop = FALSE]
  colnames(fac) <- paste0("x", 1:k)
  fac <- dplyr::mutate_all(fac, ~ ifelse(. == 1, 1, -1))
  fac_rep <- fac[rep(seq_len(nrow(fac)), rf), , drop = FALSE]

  ax <- matrix(0, nrow = 2 * k, ncol = k)
  for (j in 1:k) { ax[2*j-1, j] <- alpha; ax[2*j, j] <- -alpha }
  ax <- as.data.frame(ax)
  colnames(ax) <- paste0("x", 1:k)
  ax_rep <- ax[rep(seq_len(nrow(ax)), ra), , drop = FALSE]

  cen <- as.data.frame(matrix(0, nrow = nc, ncol = k))
  colnames(cen) <- paste0("x", 1:k)

  pts <- dplyr::bind_rows(fac_rep, ax_rep, cen)
  id  <- paste0(family, "_k", k, "_nc", nc, "_rf", rf, "_ra", ra)

  meta <- tibble::tibble(
    DesignID = id, k = k, family = family,
    nc = nc, rf = rf, ra = ra, alpha = alpha,
    N  = nrow(pts),
    Nf = nrow(fac_rep),
    Na = nrow(ax_rep),
    Nc = nc
  )

  list(points = pts, meta = meta)
}

# ----------------------------------------------------------
# build_X_quadratic()
# Builds the full second-order regression model matrix X,
# including intercept, linear terms, squared terms, and
# all pairwise interaction terms.
# ----------------------------------------------------------
build_X_quadratic <- function(df) {
  vars <- names(df)
  form <- as.formula(paste0(
    "~ ", paste(vars, collapse = " + "),
    " + ", paste0("I(", vars, "^2)", collapse = " + "),
    " + (", paste(vars, collapse = " + "), ")^2"
  ))
  model.matrix(form, data = df)
}

# ----------------------------------------------------------
# logdet_pd()
# Computes a numerically stable log-determinant of a positive
# definite matrix using the Cholesky decomposition.
# ----------------------------------------------------------
logdet_pd <- function(M) {
  R <- chol(M)
  2 * sum(log(diag(R)))
}

# ----------------------------------------------------------
# compute_ADG()
# Computes regularised D-, A-, and G-optimality criteria for
# a given design using the regularised information matrix:
#   M_lambda = X'X + lambda_scaled * I
#
# PROPER SCALED REGULARISATION:
#   The key insight is that regularisation should be a consistent
#   *fraction* of the information matrix magnitude, not an absolute
#   value. As dimensions increase, X'X grows in both size and
#   magnitude, so a fixed lambda becomes negligible.
#
#   Default scaling (scale_type = "trace"):
#     lambda_eff = lambda * (tr(X'X) / p)
#
#   This means lambda represents the fraction of the "average
#   eigenvalue" to add as regularisation. For example, lambda = 0.01
#   adds 1% of the mean diagonal element of X'X to each diagonal.
#
#   This is proper because:
#     1. It's dimensionally consistent (regularisation scales with data)
#     2. The relative perturbation to eigenvalues is constant across k
#     3. It matches the Bayesian interpretation: prior precision is
#        proportional to data precision
#     4. Condition number effects are comparable across dimensions
#
#   Alternative scaling options (set via scale_type):
#     "trace"  : lambda_eff = lambda * tr(X'X) / p (DEFAULT, proper scaling)
#     "mean_diag" : lambda_eff = lambda * mean(diag(X'X)) (equivalent to trace)
#     "max_eig": lambda_eff = lambda * lambda_max(X'X) (scale with max eigenvalue)
#     "N"      : lambda_eff = lambda * N (scale with sample size)
#     "p"      : lambda_eff = lambda * p (scale with parameters only)
#     "none"   : lambda_eff = lambda (no scaling, original behaviour)
#
# G-criterion is approximated via Monte Carlo sampling
# over the experimental region.
# ----------------------------------------------------------
compute_ADG <- function(design_points, g_n = 5000, lambda = 1e-2,
                        scale_type = "trace") {

  X    <- build_X_quadratic(design_points)
  p    <- ncol(X)
  N    <- nrow(X)
  XtX  <- crossprod(X)
 
  # Compute matrix characteristics for scaling
  tr_XtX   <- sum(diag(XtX))
  mean_diag <- tr_XtX / p
 
  # Compute scaled regularisation parameter
  # Default "trace" scaling makes lambda a fraction of average information
  lambda_eff <- switch(scale_type,
    "trace"    = lambda * mean_diag,
    "mean_diag" = lambda * mean_diag,
    "max_eig"  = lambda * max(eigen(XtX, symmetric = TRUE, only.values = TRUE)$values),
    "N"        = lambda * N,
    "p"        = lambda * p,
    "none"     = lambda,
    stop("Unknown scale_type: ", scale_type)
  )
 
  Mlam <- XtX + diag(lambda_eff, p)

  R <- tryCatch(chol(Mlam), error = function(e) NULL)
  if (is.null(R)) return(NULL)

  Minv  <- chol2inv(R)
  Dcrit <- exp(logdet_pd(Mlam) / p)
  Acrit <- sum(diag(Minv))

  k  <- ncol(design_points)
  Z  <- matrix(rnorm(g_n * k), ncol = k)
  Z  <- Z / sqrt(rowSums(Z^2))
  r  <- runif(g_n)^(1/k) * sqrt(k)
  Z  <- Z * r
  colnames(Z) <- colnames(design_points)
  FZ <- build_X_quadratic(as.data.frame(Z))
  Gcrit <- max(rowSums((FZ %*% Minv) * FZ))

  list(Dcrit = Dcrit, Acrit = Acrit, Gcrit = Gcrit, lambda_eff = lambda_eff)
}

# ----------------------------------------------------------
# reg_metrics()
# Computes RMSE and R-squared between observed and
# predicted values for regression model evaluation.
# ----------------------------------------------------------
reg_metrics <- function(y_true, y_pred) {
  rmse <- sqrt(mean((y_pred - y_true)^2))
  r2   <- 1 - sum((y_true - y_pred)^2) / sum((y_true - mean(y_true))^2)
  c(RMSE = rmse, R2 = r2)
}

# ----------------------------------------------------------
# save_obs_pred()
# Saves an observed versus predicted scatter plot for a
# given model and response variable to the specified directory.
# ----------------------------------------------------------
save_obs_pred <- function(y_true, y_pred, label, outdir) {
  df <- data.frame(obs = y_true, pred = y_pred)
  p  <- ggplot(df, aes(obs, pred)) +
    geom_point(alpha = 0.4, colour = "#2166ac") +
    geom_abline(colour = "red", linewidth = 1) +
    theme_minimal(base_size = 13) +
    labs(
      title = paste("Observed vs Predicted:", label),
      x     = "Observed",
      y     = "Predicted"
    )
  ggsave(
    file.path(outdir, paste0("obs_pred_", gsub(" ", "_", label), ".png")),
    p, width = 7, height = 5
  )
  invisible(p)
}

