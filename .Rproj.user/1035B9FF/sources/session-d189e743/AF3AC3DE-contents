cat("\n--- Dimensional Band Analysis (Structural Models) ---\n")

run_dimensional_effectiveness <- function(response_var, df, Xvars,
                                          fitted_rf, fitted_xgb,
                                          response_label) {

  model_df <- df %>%
    dplyr::filter(complete.cases(
      dplyr::across(dplyr::all_of(c(Xvars, response_var))))) %>%
    dplyr::mutate(
      dim_band = dplyr::case_when(
        k <= 6 ~ "Low (k = 3-6)",
        k >= 7 ~ "High (k = 7-10)"
      ),
      dim_band = factor(dim_band,
                        levels = c("Low (k = 3-6)", "High (k = 7-10)"))
    )

  # Use the same global 80/20 split as the main pipeline
  set.seed(6)
  idx  <- sample(seq_len(nrow(model_df)), floor(0.8 * nrow(model_df)))
  test <- model_df[-idx, ]

  band_results <- list()

  for (band in levels(model_df$dim_band)) {

    test_band <- test %>% dplyr::filter(dim_band == band)
    if (nrow(test_band) < 5) next

    x_band <- as.matrix(test_band[, Xvars])
    y_band <- test_band[[response_var]]

    # Predict using the already-fitted models — no refitting
    pred_rf  <- predict(fitted_rf,
                        data = test_band[, Xvars])$predictions
    pred_xgb <- predict(fitted_xgb,
                        xgboost::xgb.DMatrix(data = x_band))

    m_rf  <- reg_metrics(y_band, pred_rf)
    m_xgb <- reg_metrics(y_band, pred_xgb)

    band_results[[band]] <- tibble::tibble(
      Response = response_label,
      Band     = band,
      n_test   = nrow(test_band),
      RF_RMSE  = round(m_rf["RMSE"],  4),
      RF_R2    = round(m_rf["R2"],    4),
      XGB_RMSE = round(m_xgb["RMSE"], 4),
      XGB_R2   = round(m_xgb["R2"],   4)
    )
  }

  dplyr::bind_rows(band_results)
}

