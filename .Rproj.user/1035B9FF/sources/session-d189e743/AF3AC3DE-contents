# ============================================================
# VARIABLE IMPORTANCE (LOW vs HIGH)
# For A, D, G Efficiencies
# Model used internally: Random Forest
# ============================================================

library(ranger)
library(ggplot2)
library(dplyr)

set.seed(6)

dir.create("results_figures4", showWarnings = FALSE)

# ------------------------------------------------------------
# Load Data
# ------------------------------------------------------------
df_ml <- read.csv("data_generated/df_all_best_lambda.csv")
df_ml$family <- as.factor(df_ml$family)

df_ml$dim_band <- ifelse(df_ml$k <= 6,
                         "Low (3-6)",
                         "High (7-10)")

Xvars_geom <- c("k","family","alpha","N")

run_importance <- function(response_var) {
  
  all_importance <- list()
  
  for (band in unique(df_ml$dim_band)) {
    
    df_band <- df_ml %>%
      filter(dim_band == band) %>%
      filter(complete.cases(across(all_of(c(Xvars_geom, response_var)))))
    
    formula_str <- as.formula(
      paste(response_var, "~",
            paste(Xvars_geom, collapse="+"))
    )
    
    fit <- ranger(
      formula_str,
      data = df_band,
      num.trees = 800,
      importance = "permutation"
    )
    
    imp <- data.frame(
      Feature = names(fit$variable.importance),
      Importance = fit$variable.importance,
      Band = band
    )
    
    all_importance[[band]] <- imp
  }
  
  imp_df <- bind_rows(all_importance)
  
  # ----------------------------------------------------------
  # Plot
  # ----------------------------------------------------------
  p <- ggplot(imp_df,
              aes(x = reorder(Feature, Importance),
                  y = Importance,
                  fill = Band)) +
    geom_col(position = "dodge") +
    coord_flip() +
    theme_minimal(base_size = 14) +
    labs(title = paste("Variable Importance:", response_var),
         x = "",
         y = "Importance",
         fill = "Dimension Band")
  
  print(p)
  
  ggsave(
    paste0("results_figures4/importance_combined_",
           response_var, ".png"),
    p, width = 7, height = 5
  )
}

