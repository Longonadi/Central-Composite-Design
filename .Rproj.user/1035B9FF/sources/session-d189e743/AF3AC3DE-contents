# Fit separate models for low-k and high-k subsets
fit_importance_by_band <- function(df, Xvars, band_label, k_range) {
 
  df_band <- df %>%
    dplyr::filter(k >= k_range[1], k <= k_range[2]) %>%
    dplyr::filter(complete.cases(dplyr::across(dplyr::all_of(c(Xvars, "Geff", "Aeff", "Deff")))))
 
  if (nrow(df_band) < 50) return(NULL)
 
  results <- list()
 
  for (resp in c("Geff", "Aeff", "Deff")) {
    set.seed(6)
    x_mat <- as.matrix(df_band[, Xvars])
    y_vec <- df_band[[resp]]
   
    dtrain <- xgboost::xgb.DMatrix(data = x_mat, label = y_vec)
    xgb_params <- list(
      objective = "reg:squarederror",
      max_depth = 5, eta = 0.06,
      subsample = 0.8, colsample_bytree = 0.8
    )
    fit_xgb <- xgboost::xgb.train(xgb_params, dtrain, nrounds = 400, verbose = 0)
   
    imp <- xgboost::xgb.importance(model = fit_xgb) %>%
      dplyr::transmute(
        Response = gsub("eff", "-efficiency", resp),
        Feature = Feature,
        Gain = Gain,
        Band = band_label
      ) %>%
      dplyr::mutate(Gain_norm = Gain / sum(Gain))
   
    results[[resp]] <- imp
  }
 
  dplyr::bind_rows(results)
}

