# Fit models to extract importance (not for prediction evaluation)
# We use a simplified pipeline that only returns importance data

fit_for_importance <- function(response_var, df, Xvars, response_label) {
 
  cat("\n-- Fitting models for importance:", response_label, "--\n")
 
  model_df <- df %>%
    dplyr::filter(complete.cases(
      dplyr::across(dplyr::all_of(c(Xvars, response_var)))))
 
  set.seed(6)
  idx   <- sample(seq_len(nrow(model_df)), floor(0.8 * nrow(model_df)))
  train <- model_df[idx, ]
 
  x_train <- as.matrix(train[, Xvars])
  y_train <- train[[response_var]]
 
  # Random Forest for permutation importance
  fit_rf <- ranger::ranger(
    as.formula(paste(response_var, "~ .")),
    data       = train[, c(response_var, Xvars)],
    num.trees  = 800,
    importance = "permutation"
  )
 
  # XGBoost for gain-based importance
  dtrain <- xgboost::xgb.DMatrix(data = x_train, label = y_train)
  xgb_params <- list(
    objective        = "reg:squarederror",
    max_depth        = 5,
    eta              = 0.06,
    subsample        = 0.8,
    colsample_bytree = 0.8
  )
  fit_xgb <- xgboost::xgb.train(xgb_params, dtrain, nrounds = 600, verbose = 0)
 
  # Linear model for coefficient interpretation
  fit_lm <- lm(
    as.formula(paste(response_var, "~ .")),
    data = train[, c(response_var, Xvars)]
  )
 
  list(
    rf  = fit_rf,
    xgb = fit_xgb,
    lm  = fit_lm,
