# ============================================================
# OBJECTIVE 2: SPECTRAL ANALYSIS OF CCD INFORMATION MATRICES
#
# For each design, eigenvalues of the regularised information
# matrix M_lambda are extracted and summarised. Growth of the
# condition number and log-determinant across dimensions is
# modelled and plotted.
#
# Uses proper trace-based scaling: lambda_eff = lambda * tr(X'X) / p
# ============================================================

cat("\n=== OBJECTIVE 2: Spectral analysis ===\n")

meta <- readr::read_csv("data_generated/design_metadata.csv",
                        show_col_types = FALSE) %>%
  dplyr::mutate(DesignID = stringr::str_trim(DesignID))

df_all <- readr::read_csv("data_generated/df_all_best_lambda.csv",
                          show_col_types = FALSE) %>%
  dplyr::mutate(DesignID = stringr::str_trim(DesignID))

# --- 2A: Compute spectral features for every design ---

spec_list <- vector("list", nrow(meta))

for (i in seq_len(nrow(meta))) {

  id    <- meta$DesignID[i]
  fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
  if (!file.exists(fpath)) next

  pts  <- readRDS(fpath)
  X    <- build_X_quadratic(pts)
  p    <- ncol(X)
  XtX  <- crossprod(X)
 
  # Use proper trace-based scaling consistent with Objective 1
  mean_diag  <- sum(diag(XtX)) / p
  lambda_eff <- best_lambda * mean_diag
  Mlam <- XtX + lambda_eff * diag(p)

  ev <- sort(eigen(Mlam, symmetric = TRUE, only.values = TRUE)$values)
  ev <- ev[is.finite(ev) & ev > 0]
  if (length(ev) < 5) next

  q <- quantile(ev, probs = c(0.1, 0.5, 0.9), names = FALSE)

  spec_list[[i]] <- tibble::tibble(
    DesignID   = id,
    p          = p,
    mean_diag  = mean_diag,
    lambda_eff = lambda_eff,
    eig_q10    = q[1],
    eig_q50    = q[2],
    eig_q90    = q[3],
    eig_spread = q[3] / q[1],
    min_eig    = min(ev),
    max_eig    = max(ev),
    condM      = max(ev) / min(ev),
    logdetM    = sum(log(ev))
  )
}

spec_data <- dplyr::bind_rows(spec_list)

# Merge spectral features with efficiency data
df_spec <- df_all %>%
  dplyr::left_join(spec_data, by = "DesignID") %>%
  dplyr::filter(!is.na(condM)) %>%
  dplyr::mutate(log_cond = log(condM))

readr::write_csv(df_spec,
  "results_tables1/obj2_design_level_spectrum.csv")

# --- 2B: Summary by (k, family) ---

spec_summary <- df_spec %>%
