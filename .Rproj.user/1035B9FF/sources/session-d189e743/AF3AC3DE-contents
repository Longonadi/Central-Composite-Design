  dplyr::filter(meanEff > 0) %>%
  dplyr::mutate(logEff = log(meanEff), logk = log(k)) %>%
  dplyr::group_by(family, criterion) %>%
  dplyr::do({
    fit <- lm(logEff ~ logk, data = .)
    sm  <- summary(fit)
    tibble::tibble(
      beta0    = coef(fit)[["(Intercept)"]],
      beta1    = coef(fit)[["logk"]],
      SE_beta1 = sm$coefficients["logk", "Std. Error"],
      t_stat   = sm$coefficients["logk", "t value"],
      p_value  = sm$coefficients["logk", "Pr(>|t|)"],
      R2       = sm$r.squared,
      adj_R2   = sm$adj.r.squared,
      sig      = dplyr::case_when(
        sm$coefficients["logk", "Pr(>|t|)"] < 0.001 ~ "***",
        sm$coefficients["logk", "Pr(>|t|)"] < 0.01  ~ "**",
        sm$coefficients["logk", "Pr(>|t|)"] < 0.05  ~ "*",
        TRUE ~ "ns"
      )
    )
  }) %>%
  dplyr::ungroup()

