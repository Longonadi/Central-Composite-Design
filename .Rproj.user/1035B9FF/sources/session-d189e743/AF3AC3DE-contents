# ============================================================
# OBJECTIVE 4: MODEL SELECTION BY DIMENSION BAND
# Models: LM, RF, XGB, SVR, KNN
# Includes Variable Importance for Best Model
# ============================================================

library(ranger)
library(xgboost)
library(e1071)
library(FNN)
library(ggplot2)

set.seed(6)

dir.create("results_figures4", showWarnings = FALSE)
dir.create("results_tables4", showWarnings = FALSE)

# ------------------------------------------------------------
# Load Data
# ------------------------------------------------------------
df_ml <- read.csv("data_generated/df_all_best_lambda.csv")
df_ml$family <- as.factor(df_ml$family)

df_ml$dim_band <- ifelse(df_ml$k <= 6,
                         "Low (3-6)",
                         "High (7-10)")

Xvars_geom <- c("k","family","alpha","N")

reg_metrics <- function(y_true, y_pred) {
  rmse <- sqrt(mean((y_pred - y_true)^2))
  r2   <- 1 - sum((y_true - y_pred)^2) /
    sum((y_true - mean(y_true))^2)
  c(RMSE = rmse, R2 = r2)
}

run_model_selection_band <- function(response_var) {
  
  cat("\n==============================\n")
  cat("Response:", response_var, "\n")
  cat("==============================\n")
  
  for (band in unique(df_ml$dim_band)) {
    
    cat("\n--- Band:", band, "---\n")
    
    df_band <- df_ml[df_ml$dim_band == band, ]
    df_band <- df_band[complete.cases(df_band[, c(Xvars_geom, response_var)]), ]
    
    idx <- sample(seq_len(nrow(df_band)),
                  floor(0.8 * nrow(df_band)))
    
    train <- df_band[idx, ]
    test  <- df_band[-idx, ]
    
    formula_str <- as.formula(
      paste(response_var, "~",
            paste(Xvars_geom, collapse="+"))
    )
    
    results <- list()
    
    # --------------------------------------------------------
    # Linear Regression
    # --------------------------------------------------------
    fit_lm <- lm(formula_str, data=train)
    pred_lm <- predict(fit_lm, newdata=test)
    m_lm <- reg_metrics(test[[response_var]], pred_lm)
    results[["Linear Regression"]] <- data.frame(
      Model="Linear Regression",
      RMSE=m_lm["RMSE"],
      R2=m_lm["R2"]
    )
    
    # --------------------------------------------------------
    # Random Forest
    # --------------------------------------------------------
    fit_rf <- ranger(formula_str,
                     data=train,
                     num.trees=800,
                     importance="permutation")
    
    pred_rf <- predict(fit_rf, data=test)$predictions
    m_rf <- reg_metrics(test[[response_var]], pred_rf)
    results[["Random Forest"]] <- data.frame(
      Model="Random Forest",
      RMSE=m_rf["RMSE"],
      R2=m_rf["R2"]
    )
    
    # --------------------------------------------------------
    # XGBoost
    # --------------------------------------------------------
    X_train <- model.matrix(formula_str, train)[,-1]
    X_test  <- model.matrix(formula_str, test)[,-1]
    
    dtrain <- xgb.DMatrix(data=X_train,
                          label=train[[response_var]])
    
    fit_xgb <- xgb.train(
      params=list(objective="reg:squarederror"),
      data=dtrain,
      nrounds=400,
      verbose=0
    )
    
    pred_xgb <- predict(fit_xgb, X_test)
    m_xgb <- reg_metrics(test[[response_var]], pred_xgb)
    results[["XGBoost"]] <- data.frame(
      Model="XGBoost",
      RMSE=m_xgb["RMSE"],
      R2=m_xgb["R2"]
    )
    
    # --------------------------------------------------------
    # SVR (scaled)
    # --------------------------------------------------------
    X_sc_train <- scale(X_train)
    X_sc_test  <- scale(X_test,
                        center=attr(X_sc_train,"scaled:center"),
                        scale=attr(X_sc_train,"scaled:scale"))
    
    fit_svr <- svm(x=X_sc_train,
                   y=train[[response_var]],
                   type="eps-regression",
                   kernel="radial")
    
    pred_svr <- predict(fit_svr, X_sc_test)
    m_svr <- reg_metrics(test[[response_var]], pred_svr)
    results[["SVR"]] <- data.frame(
      Model="SVR",
      RMSE=m_svr["RMSE"],
      R2=m_svr["R2"]
    )
    
    # --------------------------------------------------------
    # KNN (scaled)
    # --------------------------------------------------------
    fit_knn <- FNN::knn.reg(train=X_sc_train,
                            test=X_sc_test,
                            y=train[[response_var]],
                            k=10)
    
    pred_knn <- fit_knn$pred
    m_knn <- reg_metrics(test[[response_var]], pred_knn)
    results[["KNN"]] <- data.frame(
      Model="KNN",
      RMSE=m_knn["RMSE"],
      R2=m_knn["R2"]
    )
    
    # --------------------------------------------------------
    # Results Table
    # --------------------------------------------------------
    results_tbl <- do.call(rbind, results)
    results_tbl <- results_tbl[order(-results_tbl$R2), ]
    print(results_tbl)
    
    best_model <- results_tbl$Model[1]
    cat("Best Model:", best_model, "\n")
    
    # --------------------------------------------------------
    # Variable Importance for Best Model
    # --------------------------------------------------------
    
    if (best_model == "Random Forest") {
      
      imp <- data.frame(
        Feature=names(fit_rf$variable.importance),
        Importance=fit_rf$variable.importance
      )
      
    } else if (best_model == "XGBoost") {
      
      imp <- xgb.importance(model=fit_xgb)
      imp <- imp[, c("Feature","Gain")]
      colnames(imp) <- c("Feature","Importance")
      
    } else if (best_model == "Linear Regression") {
      
      coefs <- summary(fit_lm)$coefficients
      coefs <- coefs[-1, , drop=FALSE]  # remove intercept
      
      imp <- data.frame(
        Feature=row.names(coefs),
        Importance=abs(coefs[,1])
      )
      
    } else {
      cat("Variable importance not available for", best_model, "\n")
      next
    }
    
    # Plot importance
    p_imp <- ggplot(imp,
                    aes(reorder(Feature, Importance),
                        Importance)) +
      geom_col(fill="#b2182b") +
      coord_flip() +
      theme_minimal(base_size=14) +
      labs(title=paste("Variable Importance -",best_model),
           subtitle=paste(response_var,"-",band))
    
    print(p_imp)
    
    ggsave(paste0("results_figures4/importance_",
                  response_var,"_",
                  gsub(" ","_",band),".png"),
           p_imp,width=6,height=5)
    
  }
