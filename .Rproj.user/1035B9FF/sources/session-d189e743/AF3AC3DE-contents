# ============================================================
# run_ml_pipeline()
# Trains and evaluates all six ML models for a given response
# variable. Returns fitted models and metrics for downstream use.
# ============================================================

run_ml_pipeline <- function(response_var, df, Xvars,
                            outdir_fig, outdir_tab,
                            response_label) {

  cat("\n-- Response:", response_label, "--\n")

  model_df <- df %>%
    dplyr::filter(complete.cases(
      dplyr::across(dplyr::all_of(c(Xvars, response_var)))))

  cat("Observations available:", nrow(model_df), "\n")

  # --- 80/20 random train/test split ---
  set.seed(6)
  idx   <- sample(seq_len(nrow(model_df)), floor(0.8 * nrow(model_df)))
  train <- model_df[idx, ]
  test  <- model_df[-idx, ]

  x_train <- as.matrix(train[, Xvars])
  x_test  <- as.matrix(test[, Xvars])
  y_train <- train[[response_var]]
  y_test  <- test[[response_var]]

  # Scaled predictor matrices for distance-based models (SVR, KNN)
  sc       <- scale(x_train)
  x_sc_tr  <- sc
  x_sc_te  <- scale(x_test,
                    center = attr(sc, "scaled:center"),
                    scale  = attr(sc, "scaled:scale"))

  metrics_out <- list()

  # ----------------------------------------------------------
  # MODEL 1: Linear Regression (Baseline)
  # Fits an ordinary least squares model assuming a linear
  # additive relationship between predictors and efficiency.
  # ----------------------------------------------------------
  fit1  <- lm(
    as.formula(paste(response_var, "~ .")),
    data = train[, c(response_var, Xvars)]
  )
  pred1 <- predict(fit1, newdata = test)
  m1    <- reg_metrics(y_test, pred1)
  metrics_out[["LinearRegression"]] <- data.frame(
    Model = "Linear Regression", RMSE = m1["RMSE"], R2 = m1["R2"]
  )
  save_obs_pred(y_test, pred1,
                paste("Linear Regression", response_label), outdir_fig)

  # ----------------------------------------------------------
  # MODEL 2: Random Forest
  # An ensemble of 800 decision trees trained on random
  # subsets of observations and predictors. Final prediction
  # is the average across all trees. Permutation importance
  # is computed to identify influential predictors.
  # ----------------------------------------------------------
  fit2  <- ranger::ranger(
    as.formula(paste(response_var, "~ .")),
    data       = train[, c(response_var, Xvars)],
    num.trees  = 800,
    importance = "permutation"
  )
  pred2 <- predict(fit2, data = test[, Xvars])$predictions
  m2    <- reg_metrics(y_test, pred2)
  metrics_out[["RandomForest"]] <- data.frame(
    Model = "Random Forest", RMSE = m2["RMSE"], R2 = m2["R2"]
  )
  save_obs_pred(y_test, pred2,
                paste("Random Forest", response_label), outdir_fig)

  p_rf_imp <- vip::vip(fit2, num_features = 12) +
    ggtitle(paste("Random Forest Variable Importance:", response_label))
  ggsave(
    file.path(outdir_fig,
              paste0("importance_RF_", response_var, ".png")),
    p_rf_imp, width = 8, height = 5
  )

  # ----------------------------------------------------------
  # MODEL 3: XGBoost
  # Gradient boosted trees trained sequentially, where each
  # tree corrects the residual errors of the previous ensemble.
  # Parameters: max_depth = 5, learning rate = 0.06,
  # subsampling = 0.80, column sampling = 0.80, 600 rounds.
  # ----------------------------------------------------------
  dtrain     <- xgboost::xgb.DMatrix(data = x_train, label = y_train)
  dtest      <- xgboost::xgb.DMatrix(data = x_test,  label = y_test)
  xgb_params <- list(
    objective        = "reg:squarederror",
    eval_metric      = "rmse",
    max_depth        = 5,
    eta              = 0.06,
    subsample        = 0.8,
    colsample_bytree = 0.8
  )
  fit3  <- xgboost::xgb.train(xgb_params, dtrain,
                               nrounds = 600, verbose = 0)
  pred3 <- predict(fit3, dtest)
  m3    <- reg_metrics(y_test, pred3)
  metrics_out[["XGBoost"]] <- data.frame(
    Model = "XGBoost", RMSE = m3["RMSE"], R2 = m3["R2"]
  )
  save_obs_pred(y_test, pred3,
                paste("XGBoost", response_label), outdir_fig)

  imp_xgb   <- xgboost::xgb.importance(model = fit3)
  p_xgb_imp <- ggplot(head(imp_xgb, 12),
      aes(reorder(Feature, Gain), Gain)) +
    geom_col() + coord_flip() +
    labs(x = "Feature", y = "Gain",
         title = paste("XGBoost Variable Importance:", response_label)) +
    theme_minimal(base_size = 13)
  ggsave(
    file.path(outdir_fig,
              paste0("importance_XGB_", response_var, ".png")),
    p_xgb_imp, width = 8, height = 5
  )

  # Store fitted XGBoost model in global environment for
  # combined importance plot produced after all pipelines run
  assign(paste0("xgb_fit_", response_var), fit3, envir = .GlobalEnv)

  # ----------------------------------------------------------
  # MODEL 4: Support Vector Regression (SVR, RBF kernel)
  # Fits a regression function within an epsilon-insensitive
  # tube using a radial basis function kernel to capture
  # nonlinear relationships. Requires standardised inputs.
  # ----------------------------------------------------------
  fit4  <- e1071::svm(
    x      = x_sc_tr,
    y      = y_train,
    type   = "eps-regression",
    kernel = "radial"
  )
  pred4 <- predict(fit4, x_sc_te)
  m4    <- reg_metrics(y_test, pred4)
  metrics_out[["SVR"]] <- data.frame(
    Model = "SVR (RBF kernel)", RMSE = m4["RMSE"], R2 = m4["R2"]
  )
  save_obs_pred(y_test, pred4,
                paste("SVR", response_label), outdir_fig)

  # ----------------------------------------------------------
  # MODEL 5: K-Nearest Neighbours Regression (KNN, k = 10)
  # Predicts efficiency as the average of the 10 most similar
  # training designs, where similarity is measured by
  # Euclidean distance in the standardised predictor space.
  # ----------------------------------------------------------
  fit5  <- FNN::knn.reg(
    train = x_sc_tr, test = x_sc_te, y = y_train, k = 10
  )
  pred5 <- fit5$pred
  m5    <- reg_metrics(y_test, pred5)
  metrics_out[["KNN"]] <- data.frame(
    Model = "KNN (k = 10)", RMSE = m5["RMSE"], R2 = m5["R2"]
  )
  save_obs_pred(y_test, pred5,
                paste("KNN", response_label), outdir_fig)

  # ----------------------------------------------------------
  # MODEL 6: Decision Tree (CART)
  # Fits a single regression tree that recursively partitions
  # the predictor space using binary splits selected to
  # minimise within-node variance. Tree depth is controlled
  # by cost-complexity pruning (cp = 0.001).
  # ----------------------------------------------------------
  fit6  <- rpart::rpart(
    as.formula(paste(response_var, "~ .")),
    data    = train[, c(response_var, Xvars)],
    method  = "anova",
    control = rpart::rpart.control(cp = 0.001, maxdepth = 10)
  )
  pred6 <- predict(fit6, newdata = test)
  m6    <- reg_metrics(y_test, pred6)
  metrics_out[["DecisionTree"]] <- data.frame(
    Model = "Decision Tree", RMSE = m6["RMSE"], R2 = m6["R2"]
  )
  save_obs_pred(y_test, pred6,
                paste("Decision Tree", response_label), outdir_fig)

  # Decision tree plot
  png(
    file.path(outdir_fig,
              paste0("tree_plot_", response_var, ".png")),
    width = 1200, height = 800
  )
  rpart.plot::rpart.plot(fit6, type = 4, extra = 101,
                         main = paste("Decision Tree:", response_label))
  dev.off()

  # --- Compile and save metrics table ---
  metrics_tbl <- dplyr::bind_rows(metrics_out) %>%
    dplyr::mutate(
      Response = response_label,
      n_train  = nrow(train),
      n_test   = nrow(test),
      n_predictors = length(Xvars)
    ) %>%
    dplyr::arrange(RMSE)

  readr::write_csv(
    metrics_tbl,
    file.path(outdir_tab,
              paste0("obj4_ML_metrics_", response_var, ".csv"))
  )

  cat("Results for", response_label, ":\n")
  print(metrics_tbl[, c("Model", "RMSE", "R2")])

  # Return fitted models for use in dimensional band analysis
  list(
    metrics  = metrics_tbl,
    train_df = train,
    test_df  = test,
    best_rf  = fit2,
    best_xgb = fit3,
    lm_fit   = fit1
  )
}


