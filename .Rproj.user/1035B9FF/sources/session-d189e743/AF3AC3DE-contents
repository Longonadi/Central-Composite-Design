library(reshape2)

# Function to create CDS heatmap for any criterion
create_cds_heatmap <- function(data, cds_col, criterion_filter, title_text) {
 
  # Subset data for specific criterion
  plot_data <- data %>%
    dplyr::filter(criterion == criterion_filter) %>%
    dplyr::select(family, k, !!rlang::sym(cds_col)) %>%
    dplyr::filter(!is.na(!!rlang::sym(cds_col)))
 
  if (nrow(plot_data) == 0) return(NULL)
 
  # Convert to matrix form
  data_matrix <- reshape2::dcast(plot_data, family ~ k, value.var = cds_col)
  rownames(data_matrix) <- data_matrix$family
  data_matrix <- as.matrix(data_matrix[, -1])
 
  # Log scale for variance (handle zeros/negatives)
  if (grepl("var", cds_col, ignore.case = TRUE)) {
    data_matrix[data_matrix <= 0] <- NA
    data_matrix <- log10(data_matrix)
    fill_label <- paste0("log10(", cds_col, ")")
  } else {
    fill_label <- cds_col
  }
 
  # Melt for ggplot
  data_melt <- reshape2::melt(data_matrix)
  colnames(data_melt) <- c("Family", "k", "value")
 
  # Create heatmap
  p <- ggplot(data_melt, aes(x = factor(k), y = Family, fill = value)) +
    geom_tile(color = "white", linewidth = 0.5) +
    geom_text(aes(label = round(value, 3)), color = "white", size = 3.5) +
    scale_fill_gradient(
      low = "lightblue", high = "darkblue",
      name = fill_label,
      na.value = "grey80"
    ) +
    labs(
      title = title_text,
      x = "Dimension (k)",
      y = "CCD Family"
    ) +
    theme_minimal(base_size = 14) +
    theme(
      plot.title = element_text(hjust = 0.5, face = "bold"),
      axis.text = element_text(size = 11),
      panel.grid = element_blank()
    )
 
  return(p)
}

