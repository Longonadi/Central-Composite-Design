    mean_p        = mean(p),
    mean_mean_diag = mean(mean_diag),
    mean_lam_eff  = mean(lambda_eff),
    mean_condM    = mean(condM),
    mean_logdetM  = mean(logdetM),
    mean_min_eig  = mean(min_eig),
    mean_q10      = mean(eig_q10),
    mean_q50      = mean(eig_q50),
    mean_q90      = mean(eig_q90),
    mean_spread   = mean(eig_spread),
    .groups = "drop"
  )

readr::write_csv(spec_summary,
  "results_tables1/obj2_spectral_summary_by_k_family.csv")

# --- 2C: Growth rate models ---
# Fit log-linear models to capture how condition number and
# log-determinant grow as a function of k for each family.

growth_fits <- spec_summary %>%
  dplyr::group_by(family) %>%
  dplyr::do({
    fc <- lm(log(mean_condM) ~ k, data = .)
    fd <- lm(mean_logdetM   ~ k, data = .)
    tibble::tibble(
      cond_slope = coef(fc)[2],
      cond_r2    = summary(fc)$r.squared,
      det_slope  = coef(fd)[2],
      det_r2     = summary(fd)$r.squared
    )
  }) %>%
  dplyr::ungroup()

readr::write_csv(growth_fits,
