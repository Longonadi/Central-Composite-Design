# ============================================================
# OBJECTIVE 1: CONSTRUCT AND EVALUATE CCDs (k = 3 to 10)
#
# All designs are evaluated using a regularised information
# matrix M_lambda = X'X + lambda_scaled*I. The regularisation
# parameter lambda is automatically selected from a grid
# search that maximises mean G-efficiency across all designs
# and dimensions.
#
# PROPER SCALED REGULARISATION:
#   lambda_effective = lambda_base * tr(X'X) / p
# This ensures regularisation is a consistent fraction of the
# information matrix magnitude across all dimensions.
# ============================================================

cat("\n=== OBJECTIVE 1: Design construction and efficiency evaluation ===\n")
cat("Using PROPER SCALED regularisation: lambda_eff = lambda * tr(X'X) / p\n")

# --- 1A: Define parameter grid and generate all designs ---

k_grid   <- 3:10
families <- c("FCCD", "RCCD", "SCCD")
nc_grid  <- c(1, 3, 5, 7, 10)
rf_grid  <- c(1, 2, 3)
ra_grid  <- c(1, 2, 3)

grid <- expand.grid(
  k      = k_grid,
  family = families,
  nc     = nc_grid,
  rf     = rf_grid,
  ra     = ra_grid,
  stringsAsFactors = FALSE
)

meta_list <- vector("list", nrow(grid))

for (i in seq_len(nrow(grid))) {
  row <- grid[i, ]
  out <- make_ccd(row$k, row$family, row$nc, row$rf, row$ra)
  meta_list[[i]] <- out$meta
  saveRDS(
    out$points,
    file.path("data_generated", paste0("design_", out$meta$DesignID, ".rds"))
  )
}

design_metadata <- dplyr::bind_rows(meta_list)
readr::write_csv(design_metadata, "data_generated/design_metadata.csv")
cat("Total designs generated:", nrow(design_metadata), "\n")

# --- 1B: Lambda grid search with scaled regularisation ---
# Evaluate all designs at each lambda_base to identify the
# regularisation level that maximises mean G-efficiency.
# Note: actual lambda applied is lambda_base * p

lambda_grid <- 10^seq(-10, -2, by = 1)

meta <- readr::read_csv("data_generated/design_metadata.csv",
                        show_col_types = FALSE) %>%
  dplyr::mutate(DesignID = stringr::str_trim(DesignID))

raw_list <- list()
idx <- 1

for (lam in lambda_grid) {
  for (i in seq_len(nrow(meta))) {

    id    <- meta$DesignID[i]
    fpath <- file.path("data_generated", paste0("design_", id, ".rds"))
    if (!file.exists(fpath)) next

    pts  <- readRDS(fpath)
    crit <- compute_ADG(pts, g_n = 5000, lambda = lam, scale_type = "trace")
    if (is.null(crit)) next

    raw_list[[idx]] <- tibble::tibble(
      DesignID   = id,
      lambda     = lam,
      lambda_eff = crit$lambda_eff,
      Dcrit      = crit$Dcrit,
      Acrit      = crit$Acrit,
      Gcrit      = crit$Gcrit
    )
    idx <- idx + 1
  }
}

raw_by_lambda <- dplyr::bind_rows(raw_list)
readr::write_csv(raw_by_lambda, "data_generated/raw_criteria_by_lambda.csv")

# --- 1C: Convert raw criteria to within-k efficiencies ---
# Efficiency is computed relative to the best design at each k,
# so values are between 0 and 1 within each dimensional level.

df_lam <- meta %>% dplyr::inner_join(raw_by_lambda, by = "DesignID")

eff_by_lambda <- df_lam %>%
  dplyr::group_by(lambda, k) %>%
  dplyr::mutate(
    Deff = Dcrit / max(Dcrit, na.rm = TRUE),
    Aeff = min(Acrit, na.rm = TRUE) / Acrit,
    Geff = min(Gcrit, na.rm = TRUE) / Gcrit
  ) %>%
  dplyr::ungroup()

readr::write_csv(eff_by_lambda, "data_generated/eff_by_lambda.csv")

# --- 1D: Select the best lambda ---
# Best lambda is the value that maximises mean G-efficiency
# across all designs, with D- and A-efficiency as tiebreakers.

lam_summary <- eff_by_lambda %>%
  dplyr::group_by(lambda) %>%
  dplyr::summarise(
    meanG = mean(Geff, na.rm = TRUE),
    meanD = mean(Deff, na.rm = TRUE),
    meanA = mean(Aeff, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  dplyr::arrange(desc(meanG), desc(meanD), desc(meanA))

readr::write_csv(lam_summary, "data_generated/lambda_summary.csv")

best_lambda <- lam_summary$lambda[1]
writeLines(as.character(best_lambda), "data_generated/best_lambda.txt")
cat("Best base lambda selected:", best_lambda, "\n")
cat("(Actual lambda applied = ", best_lambda, " * p for each design)\n", sep = "")

# Main analysis dataframe used in all subsequent objectives
df_all <- eff_by_lambda %>% dplyr::filter(lambda == best_lambda)
readr::write_csv(df_all, "data_generated/df_all_best_lambda.csv")

# --- 1E: Summary table and plots ---

